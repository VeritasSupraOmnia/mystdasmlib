;format hex data into a console readable format
%macro	baseregformat	3;1:output|2:input|3:free avx reg
	movdqu	%3,	[h_rax%2]
	movdqu	[s_rax%1 + outdat_offset],	%3
	movdqu	%3,	[h_rbx%2]
	movdqu	[s_rbx%1 + outdat_offset],	%3
	movdqu	%3,	[h_rcx%2]
	movdqu	[s_rcx%1 + outdat_offset],	%3
	movdqu	%3,	[h_rdx%2]
