;macro library to enable a simple bump allocator using the standard linux brk allocator which allows you to hpush and hpop a register on or off
;the top of the heapstack as well allowing a hpush or hpop of genericly-sized arrays on or off the top of the heapstack, either empty or from 
;another area in memory.

;needs syscall.ah

%macro	hpush	1-2
	%ifnum	%1
		%if	%0 = 2
		%endif
	%else

	%endif

%endmacro
