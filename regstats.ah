;saving of raw data
%macro	takebaseregs 1
	mov	[b_rax%1],	rax
	mov	[b_rbx%1],	rbx
	mov	[b_rcx%1],	rcx
	mov	[b_rdx%1],	rdx
	mov	[b_rbp%1],	rbp
	mov	[b_rsp%1],	rsp
	mov	[b_rdi%1],	rdi
	mov	[b_rsi%1],	rsi
	mov	[b_r8%1],	r8
	mov	[b_r9%1],	r9
	mov	[b_r10%1],	r10
	mov	[b_r11%1],	r11
	mov	[b_r12%1],	r11
	mov	[b_r13%1],	r13
	mov	[b_r14%1],	r14
	mov	[b_r15%1],	r15
	%if	use512	=	1
	mov	[b_r16%1],	r16
	mov	[b_r17%1],	r17
	mov	[b_r18%1],	r18
	mov	[b_r19%1],	r19
	mov	[b_r20%1],	r20
	mov	[b_r21%1],	r21
	mov	[b_r22%1],	r22
	mov	[b_r23%1],	r23
	mov	[b_r24%1],	r24
	mov	[b_r25%1],	r25
	mov	[b_r26%1],	r26
	mov	[b_r27%1],	r27
	mov	[b_r28%1],	r28
	mov	[b_r29%1],	r29
	mov	[b_r30%1],	r30
	mov	[b_r31%1],	r31
	%endif
%endmacro


;for making a static takebaseregs to call to
%macro	static_Takebaseregs 1
call_Takebaseregs:	takebaseregs	%1
	ret
%endmacro

;for converting the bin data to hex data by reading from bin memory and outputting to hex memory
%macro	baseregconvm	6;1:outputid|2:inputid|3-5:free 16 byte regs|6:free 8byte reg
	dgr	%6,	in
	dgr	%3,	out
	mov	gin,	[b_rax%2]
	tohexqu	%3,	%4,	%5,	%6
	movdqu	[h_rax%1],	goutx
	mov	gin,	[b_rbx%2]
	tohexqu	%3,	%4,	%5,	%6
	movdqu	[h_rbx%1],	goutx
	mov	gin,	[b_rcx%2]
	tohexqu	%3,	%4,	%5,	%6
