		%define	g%1	r8
		%define	g%1d	r8d
		%define	g%1w	r8w
		%define	g%1b	r8b
	%else 
		%define	g%1	archerror(r8)
		%define	g%1d	archerror(r8d)
		%define	g%1w	archerror(r8w)
		%define	g%1b	archerror(r8b)
	%endif
%endmacro
