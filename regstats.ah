	vmovdqu	[s_ymm15%1 + 32 + 6],	ymm0

	add	rsp,	32
	vmovdqu	ymm2,	[rsp]
	vmovdqu		ymm3,	ymm2
	vpermq	ymm2,	ymm2,	0b11111110
	tohexdqu	ymm0,	ymm1,	ymm2,	rax
