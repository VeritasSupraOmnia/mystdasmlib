%macro	tstb	4
%push	scope
	dgr	%4,	a
	mov	gab,	[%1]
	cmp	gab,	%2
	jne	%%f
	write	stdout,	%[s%3s],	%[l%3s]
	jmp	%%e
%%f:	write	stdout,	%[s%3f],	%[l%3f]
%%e:
%pop
%endmacro
