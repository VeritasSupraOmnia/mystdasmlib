%if	0
%macro	tohexbu	2	;to uppercase hex - byte. Fast and small but less modular version.
	%push	scope
	;output on ax
	dgr	%1,	c	;input, must be al, bl, cl or dl for high byte
	dgr	%2,	b	;arithmetic register for multiply
	;split	nibbles into two bytes in input
	mov	gch,	gcb
	shr	gcb,	4
	and	gcw,	0x0f0f
	mov	ax,	gcw
	mov	gb,	7
	sub	ax,	0x0202
	and	ax,	gcw
	and	ax,	0x0808
	mul	gb
	add	ax,	gcw
	add	ax,	0x3030
	%pop
%endmacro
%endif
;note: alt versions that are slower. Made only for use in registers r8 to r15
;To HEX Uppercase Byte Alternative
%macro	tohexbua	3	;to uppercase hex - byte. Slow and large but more modular alt version for r8 to 15.
	%push	scope
	dgr	%1,	a	;output
	dgr	%2,	b	;arithmatic value-holder
	dgr	%3,	c	;input, must be al, bl, cl or dl for high byte
	;split	nibbles into two bytes in input
	mov	gbb,	gcb
	shr	gcb,	4
	shl	gbw,	8
	or	gcw,	gbw
	and	gcw,	0x0f0f
	mov	gbw,	gcw
	sub	gbw,	0x0202
	and	gbw,	gcw
	and	gbw,	0x0808
	shr	gbw,	1
	mov	gaw,	gbw
	shr	gaw,	1
	or	gaw,	gbw
	shr	gaw,	1
	or	gaw,	gbw
	add	gaw,	gcw
	add	gaw,	0x3030
	%pop
%endmacro
;
%macro	tohexbua	2	;to uppercase hex - byte. Fast and small but less modular alt version for r8-15.
	%push	scope
	;output on ax
	dgr	%1,	b	;arithmatic value-holder
	dgr	%22,	c	;input, must be al, bl, cl or dl for high byte
	;split	nibbles into two bytes in input
	mov	gbb,	gcb
	shr	gcb,	4
	shl	gbw,	8
	or	gcw,	gbw
	and	gcw,	0x0f0f
	mov	gbw,	gcw
	sub	gbw,	0x0202
	and	gbw,	gcw
	and	gbw,	0x0808
	mov	ax,	gbw
	mul	7
	add	ax,	gcw
	add	ax,	0x3030
	%pop
%endmacro

;To HEX Lowercase Byte
%macro thexlb	3
	%push	scope
	dgr	a,	%1	;out on gab
	dgr	b,	%2
	dgr	c,	%3	;in on gcw
	mov	gch,	gcb
	shr	gcb,	4
	and	gcw,	0x0f0f
	mov	gbw,	gcw
	sub	gbw,	0x0202
	and	gbw,	gcw
	and	gbw,	0x0808
	shr	gbw,	3
	mov	gaw,	gbw
	shl	gaw,	2
	or	gaw,	gbw
	shl	gaw,	1
	or	gaw,	gbw
	shl	gaw,	1
	or	gaw,	gbw
	add	gaw,	gcw
	add	gaw,	0x30
	%pop
%endmacro
%macro tohexql	4
	%push	scope
	dgr     %1,     1;output        -       16 byte
	dgr     %2,     2;bitmask       -       16 byte
	dgr     %3,     3;arithmetic    -       16 byte
	dgr     %4,     4;input and broadcast loader -  8 byte
	bswap   g4
	movq    g3x,    g4
	pxor    g2x,    g2x
	vpunpcklbw      g3x,    g2x,    g3x
	movdqu  g2x,    g3x
	psrlw   g2x,    12
	por     g3x,    g2x
	mov     g4,     0x0f0f0f0f0f0f0f0f
	movq    g2x,    g4
	vpbroadcastb    g2x,    g2x
	pand    g3x,    g2x
	mov     g4,     0x0909090909090909
	movq    g2x,    g4
	vpbroadcastq    g2x,    g2x
	vpcmpgtb        g1x,    g3x,    g2x
	mov     g4b,    0xd8
	movq    g2x,    g4
	vpbroadcastb    g2x,    g2x
	pand    g2x,    g1x
	psubb   g1x,    g2x
	paddb   g1x,    g3x
	mov     g4b,    0x30
	movq    g2x,    g4
	vpbroadcastb    g2x,    g2x
	paddb   g1x,    g2x
	%pop
%endmacro
