;macros related to comparing and finding bytes with finesse.
;NOTE: don't do a pre-macro byteswap on the inputs, just feed it in.

;checks for a string in a qword and outputs either -1 or the found location
%macro	fndq	6
	;scratches rcx

	;take quadword of sought chars and count of sought chars
	;then copy the compare-to register to a temp reg
	;then make an 0xff bitmask register of the comparator register's rightmost, zeroed bytes.
	;AND the temp reg into the bitmask then xor the bitmask into the temp reg
	;do a cmp on the sought chars and temp registers
	;if equal, do make an 0xff of bitmask register of the sought chars left, non-zeroed bytes.
	;also make another temp reg which is a NOT'd copy of the compare-to reg, then or it into the bitmask reg
	;then AND the compare-to register into the bitmask followed by a XOR of the bitmask into the compare-to
%push	scope
	dgr	%1,	1;output of found index or -1 for not found
	dgr	%2,	2;input	of 8 byte reg containing string to search in
	dgr	%3,	3;input of register containing string to search for
	dgr	%4,	4;size of string to search for in bytes
	dgr	%5,	5;holder of leading zero bytemask (one side of leading zero byte is 0xff the other is 0x00)
	dgr	%6,	6;holder of compare to copy
	
	xor	g1,	g1
	mov	rcx,	g4
	shl	rcx,	3
	dec	rcx
	mov	g5,	1
	shl	g5,	cl
	mov	rcx,	8
	blsmsk	g5,	g5
	
%%lp:	mov	g6,	g2
	and	g6,	g5
	cmp	g6,	g3
	je	%%exit
	inc	g1
	shr	g2,	8
	loop	%%lp
	mov	g1,	-1
%%exit:	
%pop
%endmacro

;checks for a string being contained within a yword and outputs either -1 or the location.
%macro	fndy	8
%push	scope
	dgr	%1,	1;output of found index or -1 for not found
	dgr	%2,	2;input	of 32 byte reg containing string to search in
	dgr	%3,	3;input of register containing string to search for
	dgr	%4,	4;size of string to search for in bytes
	dgr	%5,	5;holder of leading zero bytemask (one side of leading zero byte is 0xff the other is 0x00)
	dgr	%6,	6;holder of current qword index of the 32 byte reg
	dgr	%7,	7;holder of temp feed
	dgr	%8,	8;holder of vpshrvq index data for shifting in new data to the next quadword in g2y, avx2 reg
	
	;setup andmask and shiftmask
	xor	g1,	g1
	mov	rcx,	g4
	shl	rcx,	3
	dec	rcx
	mov	g5,	1
	shl	g5,	cl
	mov	rcx,	32
	blsmsk	g5,	g5
	mov	g6,	8
	movq	g8x,	g6

	;beginning index check
	movq	g7,	g2x
	vpermq	g2y,	g2y,	0b00111001
	mov	g6,	g7
	and	g6,	g5
	cmp	g6,	g3
	je	%%end

	;beginning index no match handle
	inc	g1
	mov	g6,	g7
	shr	g6,	8
	movq	g7,	g2x
	and	g7d,	0x000000ff
	bswap	g7
	or	g6,	g7
	vpsrlvq	g2y,	g8y
	
	%rep	7
	;end first qword indexes checks
	mov	g7,	g6
	and	g6,	g5
	cmp	g6,	g3
	je	%%end

	;end first qword indexes no match handles
	inc	g1
	mov	g6,	g7
	shr	g6,	8
	movq	g7,	g2x
	and	g7d,	0x000000ff
	bswap	g7
	or	g6,	g7
	vpsrlvq	g2y,	g8y
	%endrep
	
	;move the yreg right 1 qword
	vpermq	g2y,	g2y,	0b00111001

	;second qword indexes checks
	%rep	8
	mov	g7,	g6
	and 	g6,	g5
	cmp	g6,	g3
	je	%%end

	;second qword no match handles
	inc	g1
	mov	g6,	g7
	shr	g6,	8
	movq	g7,	g2x
	and	g7d,	0x000000ff
	bswap	g7
	or	g6,	g7
	vpsrlvq	g2y,	g8y
	%endrep

	vpermq	g2y,	g2y,	0b00111001

	;third qword indexes checks
	%rep	8
	mov	g7,	g6
	and 	g6,	g5
	cmp	g6,	g3
	je	%%end

	;third qword no match handles
	inc	g1
	mov	g6,	g7
	shr	g6,	8
	movq	g7,	g2x
	and	g7d,	0x000000ff
	bswap	g7
	or	g6,	g7
	vpsrlvq	g2y,	g8y
	%endrep
	
	;setup fat processing loop
	mov	rcx,	8
	sub	rcx,	g4
	mov	g7,	g6

	;fat proccessing

%%lp:	and	g6,	g5
	cmp	g6,	g3
	je	%%end
	shr	g7,	8
	mov	g6,	g7
	inc	g1
	loop	%%lp
	jmp	%%fail

%%fail:	mov	g1,	-1
%%end:	
%pop
%endmacro

;checks whether y reg contains byte using vptest - sets flag nz for contains, z for not contains
%macro	bcontainsy	3
%push	scope
	dgr	%1,	in1;b input - for byte mask
	dgr	%2,	in2;y input - for input register
	dgr	%3,	sc;y scratch
	movd	gscx,	gin1d
	vpbroadcastb	gscy,	gscx
	vpcmpeqb	gscy,	gscy,	gin2y
	vptest	gin2y,	gscy
%pop
%endmacro
