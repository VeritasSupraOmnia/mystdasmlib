;conditionally generalize extensions

%macro	d_v0	1
	%if	use128 = 1	%define	g%1x	xmm0
		%else 	%define	g%1x	featerror(xmm0,cpu_fset)	%endif
	%if	use256 = 1	%define	g%1y	ymm0	
		%else	%define	g%1y	featerror(ymm0,cpu_fset)	%endif
	%if	use512 = 1	%define	g%1z	zmm0
		%else	%define	g%1z	featerror(zmm0,cpu_fset)	%endif
%endmacro
