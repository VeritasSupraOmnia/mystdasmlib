%macro	udgr	1
	%ifdef	g%1
		%undef g%1
		%undef g%1d
		%undef g%1w
		%undef g%1b
		%ifdef	g%1h
			%undef g%1h
		%endif
	%elifdef	g%1d
		%if use64b = 1
			%undef g%1
		%endif
		%undef	g%1d
		%undef	g%1w
		%undef	g%1b
		%ifdef	g%1h
			%undef	g%1h
		%endif
	%elifdef	g%1w
		%if use64b = 1
			%undef	g%1
		%endif
		%if use32b = 1
			%undef	g%1d
		%endif
		%undef	g%1w
		%undef	g%1b
		%ifdef	g%1h
			%undef	g%1h
		%endif
	%elifdef	g%1x
		%undef	g%1x
		%if use256 = 1
			%undef	g%1y
		%endif
		%if use512 = 1
			%undef g%1z
		%endif
	%elifdef	g%1y
		%undef	g%1x
		%undef	g%1y
		%if use512 = 1
			%undef g%1z
		%endif
	%elifdef g%1z
		%undef	g%1x
		%undef	g%1y
		%undef	g%1z
	%endif
%endmacro
%if	0
;macro for defining a called implementation of another macro
%macro	calledm	1+
c%1:	%1	
ret
%endmacro
%endif
;Possible feature: register-in-use table 
;Using a quadword sized number define (with each bit representing a register slot) check-reg-open/check-reg-closed macros, one can keep track of which register is in use and output register use flow as well as enabling the detection of register conflicts.
