; OPENING MACROS

%macro open_r 1
	mov	eax, sys_open
	mov rdi, %1
	mov esi, readonly
	xor edx, edx
	syscall
%endmacro
%macro open_w 1
	mov	eax, sys_open
	mov rdi, %1
	mov esi, writeonly
	xor edx, edx
	syscall
%endmacro
%macro open_wr 1
	mov	eax, sys_open
	mov rdi, %1
	mov esi, readwrite
	xor edx, edx
	syscall
%endmacro
%macro close_fd 1
	mov rdi, %1
	mov eax, sys_close
	syscall
%endmacro

; SEEKING MACROS

%define seek_set 0
%define seek_cur 1
%define seek_end 2

; First arg is always fd

; Seek beginning offset
%macro seekb 2
	mov rdi, %1
	mov rsi, %2
	mov edx, seek_set
	mov eax, sys_lseek
	syscall
%endmacro

; Seek current position offset
%macro seekc 2
	mov rdi, %1
	mov rsi, %2
	mov edx, seek_cur
	mov eax, sys_lseek
	syscall
%endmacro

; Seek end offset
%macro seeke 2
	mov rdi, %1
	mov rsi, %2
	mov edx, seek_end
	mov eax, sys_lseek
	syscall
%endmacro

%macro getfilesize 2
	seekc %1, 0
	mov %2, rax
	seeke %1, 0
	xchg %2, rax
	mov rsi, rax
	mov edx, seek_set
	mov rdi, %1
	mov eax, sys_lseek
	syscall
%endmacro

; IO MACROS

; Easier write setup
; use:	write	stout,	charbuffer,	[length_charbuffer]
%macro	write	3
mov	rdi,	%1		; non immediates first to stave off some possible reg clobber bugs
mov	rsi,	%2
mov	rdx,	%3
mov	eax,	sys_write	;1
syscall
%endmacro

; Like write but only to stdout.
%macro	printbuff	2
mov	rsi,	%1		
mov	rdx,	%2
mov	eax,	sys_write
mov	edi,	eax		;stdout is same as sys_write
syscall
%endmacro

; Easier read setup.
; Use	read	stdin,	charbuffer,	[num_chars_to_read]
%macro	read	3
mov	rdi,	%1
mov	rsi,	%2
mov	rdx,	%3
xor	eax,	eax	;sys_read is equal to 0
syscall
%endmacro

; Like read but only from stin.
%macro sinput	2
mov	rsi,	%1
mov	rdx,	%2
xor	eax,	eax
xor	edi,	edi
%endmacro

%macro	pread	4
mov	rax,	sys_pread
mov	rdi,	%1;file descriptor
mov	rsi,	%2;input buffer address
mov	rdx,	%3;count
mov	r10,	%4;offset
syscall
%endmacro
%macro	pwrite	4
mov	rax,	sys_pwrite
mov	rdi,	%1
mov	rsi,	%2
mov	rdx,	%3
mov	r10,	%4
syscall
%endmacro

%macro	brk	1
	mov	rax,	sys_brk
	mov	rdi,	%1
	syscall
%endmacro

%macro	getpid	0
	mov	rax,	sys_getpid
	syscall
%endmacro
%macro	getppid	0
	mov	rax,	sys_getppid
	syscall
%endmacro
%macro	gettid	0
	mov	rax,	sys_gettid
	syscall
%endmacro
; Quick clone for splitting into another thread.
%macro	clonevm 1
	mov	rax,	sys_clone
	mov	rdi,	clone_vm | clone_thread | clone_files | clone_io
	mov	rsi,	%1
	syscall
%endmacro

%macro	pipedat 0
	pread:	dq	0
	pwrite:	dq	0
%endmacro

; Exit without returning error.
%macro nominal_exit 0
	mov eax, sys_ret
	xor edi,edi
	syscall
%endmacro

; Uses mmap to allocate a chunk of memory using address %1 of 0, or reallocate with an address.
%macro alloc 2
	mov eax, sys_mmap
	mov rdi, %1
	mov rsi, %2
	mov edx, prot_read|prot_write
	mov ecx, map_private|map_anon
	mov r8, -1
	xor r9,r9
	xor r10,r10
	syscall
%endmacro

;maps file directly into bss memory - template for other 
%macro bssmmap_t 5
	mov rdi, %1 ; bss memory location - needs to be alignedb'd to page width (4096)
	mov rsi, %2 ; length of map
	%if %3 = 0
	xor r8, r8
	%else
	mov r8, %3	; file descriptor
	%endif
	%if %4 = 0
	xor r9, r9
	%else
	mov r9, %4	; offset
	%endif
	mov edx, %5	; passed from -bssmmap_r-, -bssmmap_w- and -bssmmap_rw-
	mov r10d, map_shared | map_fixed | map_populate
	mov eax, sys_mmap
	syscall
%endmacro
%macro bssmmap_r 4 ; --bssmmap_r--
	bssmmap_t %1, %2, %3, %4, prot_read
%endmacro
%macro bssmmap_w 4 ; --bssmmap_w--
	bssmmap_t %1, %2, %3, %4, prot_write
%endmacro
%macro bssmmap_rw 4 ; --bssmmap_rw--
	bssmmap_t %1, %2, %3, %4, prot_write | prot_read
%endmacro
