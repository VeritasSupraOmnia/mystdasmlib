%include	'../genreg.ah'
%include	'../cstring.ah'
%include	'../syscall.ah'
%include	'../size.ah'
%include	'../hex.ah'
%include	'../regstats.ah'
global	main

section .data
	newstrla	failure,	"hex.ah		Test failure!"
	newstrla	success,	"hex.ah		Test success!"
;	baseregbindata	1
;	basereghexdata	1
;	basereghoutdata	1
;	avx2regbindata	1
;	avx2reghexdata	1
	avx2regoutdata	1
	;testing data is as follows: first char in label is size, second is whether it is converted to or from hexadecimal, third is whether it is the test or desired result, fourth is whether output is uppercase. 
	;example1:	btt - byte to hexadecimal test 
	;example2:	qfr - quadword from hexidecimal result 

	;note: result data is always 2x the size of test data

	;test over one byte
	bytebin:	db	0x9A
	bytehexu:	dw	'9A'
	bytehexl:	dw	'9a'
	dwordbin:	dd	0x02468ACE
	dwordhexu:	dq	'02468ACE'
	quadbin:	dq	0x0123456789ABCDEF
	quadhexu:	dq	'01234567','89ABCDEF'
	quadhexl:	dq	'01234567','89abcdef'
	dquadbin:	dq	0xA123456789ABCDEF,0xFEDCBA9876543210
	dquadhexu:	dq	'A1234567','89ABCDEF','FEDCBA98','76543210'
	dquadhexl:	dq	'01234567','89abcdef','fedcba98','76543210'
section	.code
main:
	mov	dl,	[bytebin]
	xor	rsi,	rsi
	xor	rdi,	rdi
	tohexbu	rdi,	rsi,	rdx
	mov	ax,	[bytehexu]
	cmp	ax,	di
	jne	failure

	mov	dl,	[bytebin]
	xor	rsi,	rsi
	xor	rdi,	rdi
	tohexbua	rdi,	rsi,	rdx
	mov	ax,	[bytehexu]
	cmp	ax,	di
	jne	failure
	
	mov	dx,	[bytehexu]
	frhexbu	ax,	di, dx
	mov	dl,	[bytebin]
	cmp	al,	dl
	jne	failure
	
%if	0
	mov	cl,	[bytebin]
	xor	r8,	r8
	tohexbu	cl,	r8
	mov	dx,	[bytehexu]
	cmp	ax,	dx
	jne	failure
%endif
	
	mov	edx,	[dwordbin]
	xor	rsi,	rsi
	xor	rdi,	rdi
	tohexdu	rdi,	rsi,	rdx
	mov	rax,	[dwordhexu]
	cmp	rax,	rdi
	jne	failure

	mov	rdx,	[dwordhexu]
	xor	rsi,	rsi
	xor	rdi,	rdi
	frhexdu	rdi,	rsi,	rdx
	mov	eax,	[dwordbin]
	cmp	eax,	edi
	jne	failure

	mov	r10,	[quadbin]
	tohexqu	xmm0,	xmm1,	xmm2,	r10
	movdqu	xmm1,	[quadhexu]
	ptest	xmm0,	xmm1
	jnc	failure
	
	mov	r10,	[quadbin]
	tohexql	xmm0,	xmm1,	xmm2,	r10
	movdqu	xmm1,	[quadhexl]
	ptest	xmm0,	xmm1
	jnc	failure

	movdqu	xmm0,	[quadhexu]
	frhexqu	rax,	rdi,	rsi,	xmm2,	xmm1,	xmm0
	mov	rdi,	[quadbin]
	cmp	rax,	rdi
	jne	failure

	vmovdqu	ymm0,	[dquadhexu]
	frhexdqu	xmm3,	rsi,	xmm4,	xmm2,	xmm1,	xmm0
	movdqu	xmm5,	[dquadbin]
	vptest	ymm3,	ymm5
	jnc	failure

	movdqu	xmm0,	[quadhexl]
	frhexql	rax,	rdi,	rsi,	xmm2,	xmm1,	xmm0
;	baseregstohout	1
	mov	rdi,	[quadbin]
	cmp	rax,	rdi
	jne	failure
	
	movdqu	xmm2,	[dquadbin]
	tohexdqu	ymm0,	ymm1,	ymm2,	rax
	vmovdqu	[dquadhexu],	ymm0
	vmovdqu	ymm1,	[dquadhexu]
	avx2regstohout	1
;	write	stdout,	dquadhexu,	32
	vptest	ymm1,	ymm0
	jnc	failure


	jmp	success
failure:mov	rax,	sys_write
	mov	rdi,	stdout
	mov	rsi,	sfailure
	mov	rdx,	[lfailure]
	syscall
;	write stdout,	s_rax1,	ohdat_totalsize
	write stdout,	s_ymm01,	oavx2_totalsize
	mov	rax,	sys_ret
	mov	rdi,	1
	syscall
success:mov	rax,	sys_write
	mov	rdi,	stdout
	mov	rsi,	ssuccess
	mov	rdx,	[lsuccess]
	syscall
;	write stdout,	s_rax1,	ohdat_totalsize
	write stdout,	s_ymm01,	oavx2_totalsize
	mov	rax,	sys_ret
	mov	rdi,	0
	syscall
