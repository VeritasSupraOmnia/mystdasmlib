;conditionally generalize extensions

%macro	d_v0	1
	%if	use128 = 1	
		%define	g%1x	xmm0
	%endif
	%if	use256 = 1	
		%define	g%1y	ymm0	
	%endif
	%if	use512 = 1	
		%define	g%1z	zmm0
	%endif
%endmacro
