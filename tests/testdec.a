%include	"../genreg.ah"
%include	"../hex.ah"
%include	"../regstats.ah"
%include	"../dec.ah"
%include	"../cstring.ah"
%include	"../syscall.ah"

global	main
section	.data
	
	resb:	db	'0255'
	testb:	db	0xff
	resw:	db	'00065535'
	testw:	dw	0xffff
	resd:	db	'0000004294967295',0x0A
	testd:	dd	0xffffffff
	resq:	db	'00000000000018446744073709551615',0x0A
	resqa:	db	'18446744073709551615000000000000',0x0A
	testq:	dq	0xffffffffffffffff


;	baseregbindata	1
;	basereghexdata	1
;	basereghoutdata	1
;	avx2regbindata	1
;	avx2reghexdata	1
;	avx2regoutdata	1

	newstrla	failure,	"dec.ah:		Test failure!"
	newstrla	success,	"dec.ah:		Test success!"
section	.code
main:	xor	rax,	rax
	mov	al,	[testb]
	todecb	r8,	rdi
	mov	r9d,	[resb]
	cmp	r8d,	r9d
	jne	fail
	
	mov	edi,	[resb]
	frdecb	r8,	rdi
	mov	r9b,	[testb]
	cmp	r8b,	r9b
	jne	fail

	xor	rax,	rax
	mov	ax,	[testw]
	todecw	r8,	rdi
	mov	r9,	[resw]
	cmp	r8,	r9
	jne	fail
	
	mov	rdi,	[resw]
	frdecw	r8,	rdi
	mov	r9w,	[testw]
	cmp	r8w,	r9w
	jne	fail
	
	xor	rax,	rax
	mov	eax,	[testd]
	todecd	xmm0,	xmm1,	r8,	xmm2
	movdqu	xmm1,	[resd]

	;tests for equality across whole register - this testing method is known to work
	vptest	xmm0,	xmm1
	jnc	fail
	
	xor	rax,	rax
	mov	rax,	[testq]
	todecq	ymm0,	r8,	r9,	ymm1
	vmovdqu	ymm1,	[resq]
	vptest	ymm0,	ymm1
	jnc	fail

;	Example of todecqa used and the exactly 20 byte(shh!) memory write detailed in the comments above it in dec.ah
;	xor	rax,	rax
;	mov	rax,	[testq]
;	todecqa	ymm0,	r8,	r9,	ymm1
;	vpandn	ymm1,	ymm1,	ymm1
;	vpand	ymm1,	ymm1,	[resq]
;	vpor	ymm0,	ymm0,	ymm1
;	vmovdqu	[resq],	ymm0
;	write	stdout,	resq,	20	

	write	stdout,	ssuccess,	[lsuccess]
	jmp	end
fail:	
	write	stdout,	sfailure,	[lfailure]
	jmp	end

end:	
;	basereghconvm	1,	1,	xmm0,	xmm1,	xmm3,	r8
;	basereghformat	1,	1,	xmm0
;	write	stdout,	s_rax1,	ohdat_totalsize
;	avx2regconvm	1,	1,	xmm0,	xmm1,	xmm3,	r8
;	avx2regformat	1,	1,	xmm0
;	write	stdout,	s_ymm01,	oavx2_totalsize
	mov	rax,	sys_ret
	mov	rdi,	0
	syscall
