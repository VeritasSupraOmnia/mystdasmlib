;move ssereg hex data int formatted slot for clean printing
;args - 1:outputdata 2:inputdata 3:avx reg
%macro	sseregformat	3
%push	scope	
	dgr	%3,	1
	vmovdqu	g1y,	[h_xmm0%2]
	vmovdqu	[s_xmm0%1 + 6],	g1y
	vmovdqu	g1y,	[h_xmm1%2]
	vmovdqu	[s_xmm1%1 + 6],	g1y
	vmovdqu	g1y,	[h_xmm2%2]
