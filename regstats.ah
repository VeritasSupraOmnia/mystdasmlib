%macro	takeavx2reg	1
	vmovdqu	[b_ymm0%1],	ymm0
	vmovdqu	[b_ymm1%1],	ymm1
	vmovdqu	[b_ymm2%1],	ymm2
	vmovdqu	[b_ymm3%1],	ymm3
	vmovdqu	[b_ymm4%1],	ymm4
	vmovdqu	[b_ymm5%1],	ymm5
	vmovdqu	[b_ymm6%1],	ymm6
	vmovdqu	[b_ymm7%1],	ymm7
	vmovdqu	[b_ymm8%1],	ymm8
	vmovdqu	[b_ymm9%1],	ymm9
	vmovdqu	[b_ymm10%1],	ymm10
	vmovdqu	[b_ymm11%1],	ymm11
	vmovdqu	[b_ymm12%1],	ymm12
	vmovdqu	[b_ymm13%1],	ymm13
	vmovdqu	[b_ymm14%1],	ymm14
