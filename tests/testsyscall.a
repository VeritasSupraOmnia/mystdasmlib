%include	"./syscall.ah"
%include	"./cstring.ah"
%include	"./head.ah"

;test various syscalls and syscall macros detailed in "syscall.ah"
c_ehdr	64,	main,	bss_size
newstrla fail, "test_syscall	failure!"
newstrla succ, "test_syscall	success!"
path:	db "./tests/testfile.txt",0
main:

	open_r path		; Test open to right file descriptor
	cmp rax, 3
	jne fail

	mov r14, rax	; Save file descriptor to preserved register

	seeke r14, 0	; test seek to end
	cmp rax, 64
	jne fail

	seekb r14, 0	; test seek to beginning
	cmp rax, 0
	jne fail
	
	getfilesize r14, r15
	cmp r15, 64		; test file size get
	jne fail
	cmp rax, 0		; test also returned to beginning
	jne fail

	
	write stdout, ssucc, lsucc
	jmp exit

fail:
	write stdout, sfail, lfail

exit:
	close_fd r14
	nominal_exit
c_ftr
bsq fd, 1
thex: resq 2
resb 1
e_bss
