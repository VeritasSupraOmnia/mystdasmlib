; Syscalls for linux
%define	libsyscall	1

; -1 for return checking
%define	err		0xffffffffffffffff

; Standard file descriptions
%define	stdin		0
%define	stdout		1
%define	stderr		2

; Standard file access flag values
%define	readonly	0
%define	writeonly	1
%define	readwrite	2
%define create		0x40
%define append		0x0400
%define	truncate	0x0200
%define nonblock	0x0800

; Standard file access modes
%define	rwxu		0x0700
%define	ru		0x0400
%define	wu		0x0200
%define	xu		0x0100
%define	rwxg		0x0070
%define	rg		0x0040
%define	wg		0x0020
%define	xg		0x0010
%define	rwxo		0x0007
%define	ro		0x0004
%define	wo		0x0002
%define	xo		0x0001
%define	setuserid	0x4000
%define	setgroupid	0x2000
%define	stickybit	0x1000

; Standard linux signals
;%define	SIGKILL	0x09
;%define	SIGCHLD	0x11
;%define	SIGCONT	0x12

; sys_clone bitmask values
%define	clone_vm	0x0100
%define	clone_io	0x80000000
%define	clone_files	0x0400
%define	clone_vfork	0x004000
%define	clone_thread	0x010000

; sys_wait flags
%define	wexited	0x04

; sys_mmap prot states
%define	prot_read	0x01
%define	prot_write	0x02
%define	prot_exec	0x04
%define	prot_none	0x00

; sys_mmap flags
%define	map_shared	0x01
%define	map_private	0x02
%define	map_fixed	0x10
%define map_anon	0x20
%define	map_populate	0x8000

; All sys_ functions put ther id numbers (0 for sys_read, 1 for sys_write, etc) into rax and are called with the
; syscall instruction.
%define	sys_read					0	;rdi: fd	rsi: char buffer address	rdx: byte count
%define	sys_write					1	;rdi: fd	rsi: char buffer address	rdx: byte count
%define	sys_open					2	;rdi: path-string-pointer	rsi: flags
%define	sys_close					3	;rdi: fd
%define	sys_stat					4	;rdi: fd
%define	sys_fstat					5	;rdi: fd
%define	sys_lstat					6	;rdi: fd
%define	sys_poll					7	;rdi: fdpoll struct aray pointer (8 bytes)	rsi: fd count	rdx: timeout
;------------------------------------
%define	sys_lseek					8	;rdi: fd		rsi:offset			rdx:
%define	sys_mmap					9	;rdi: addr		rsi: len			rdx: prot	r10: flags	r8: fd	r9: offset
%define	sys_mprotect				10
%define sys_mumap					11
%define	sys_brk						12	;rdi: bytes to make brk
%define	sys_sigaction				13
%define	sys_sigprocmask				14
%define	sys_sigreturn				15
;------------------------------------
%define	sys_ioctl					16
%define sys_pread					17	;rdi:fd		rsi:char buffer address	rdx:byte count	r10:offset
%define sys_pwrite					18	;rdi:fd		rsi:char buffer address	rdx:byte count	r10:offset
%define	sys_readv					19
%define	sys_writev					20
%define	sys_access					21
%define sys_pipe					22	;rdi:pointer to double quadword for pipe read and write file descripter
%define	sys_select					23
