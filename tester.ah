;needs genreg cstring.ah and syscall.ah included above this

%macro	newtest1 2
%push	scope
	%defstr		%%suc	%2':	success'
	%defstr		%%fai	%2':	failure'
	newstrla	%1s,	%%suc
	newstrla	%1f,	%%fai
%pop
%endmacro
