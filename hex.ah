;needs genreg.ah

;To HEX Uppercase Byte
%macro	tohexbu	3	;to uppercase hex - byte. Slow and large but more modular version.
	dgr	%1,	a	;output
	dgr	%2,	b	;arithmatic value-holder
	dgr	%3,	c	;input, must be al, bl, cl or dl for high byte
	;split	nibbles into two bytes in input
	mov	gch,	gcb
	shr	gcb,	4
	and	gcw,	0x0f0f
	mov	gbw,	gcw
	sub	gbw,	0x0202
	and	gbw,	gcw
	and	gbw,	0x0808
	shr	gbw,	1
	mov	gaw,	gbw
	shr	gaw,	1
	or	gaw,	gbw
	shr	gaw,	1
	or	gaw,	gbw
	add	gaw,	gcw
	add	gaw,	0x3030
	udgr	a
	udgr	b
	udgr	c
%endmacro

;From DEX Uppercase Byte
%macro	frhexbu	3
	dgr	%1,	1;output
	dgr	%2,	2;arithmetic reg
	dgr	%3,	3;input - this is a word in size
	
	mov	g2w,	g3w
	and	g2w,	0x4040
	shr	g2w,	4
	mov	g1w,	g2w
	shr	g1w,	1
	or	g2w,	g1w
	shr	g1w,	1
	or	g2w,	g1w
	sub	g3w,	g2w
	and	g3w,	0x0f0f
	ror	g3w,	8
	mov	g2w,	0x0f0f
	pext	g1d,	g3d,	g2d
	
	udgr	1
	udgr	2
	udgr	3
%endmacro

%macro	tohexqu	6
	dgr	%1,	1;output	-	16 byte
	dgr	%2,	2;bitmask	-	16 byte
	dgr	%3,	3;arithmetic	-	16 byte
	dgr	%4,	4;pdep output holder -	8 byte
	dgr	%5,	5;pdep mask	-	8byte
	dgr	%6,	6;input		-	8byte

	mov	g5,	0x0f0f0f0f0f0f0f0f
	pdep	g4,	g5,	g6;pdep first half of input to holder
	movq	g1x,	g4
	pslldq	g1x,	8
	shr	g6,	32
	pdep	g4,	g5,	g6
	movq	g2x,	g4
	pand	g1x,	g2x
	mov	g4,	0x08
	movq	g3x,	g4
	mov	g6,	0x30
	vpbroadcastb	g2x,	g3x
	vpcmpgtb	g3x,	g1x,	g2x
	vpcmpeqb	g2x,	g1x,	g2x
	pand	g3x,	g2x
	psllw	g3x,	1
	movdqu	g2x,	g3x
	psllw	g2x,	1
	por	g3x,	g2x
	psllw	g2x,	1
	por	g3x,	g2x
	psllw	g2x,	1
	por	g3x,	g2x
	paddb	g1x,	g3x
	movq	g3x,	g6
	vpbroadcastb	g2x,	g3x
	paddb	g1x,	g2x

	udgr	1
	udgr	2
	udgr	3
	udgr	4
	udgr	5
	udgr	6
%endmacro
;TODO:	Fix this macro
%macro	frhexqu	6
	dgr	%1,	1;output reg-	8bytes
	dgr	%2,	2;mask reg  -	8bytes
	dgr	%3,	3;cross reg -	8bytes
	dgr	%4,	4;arith	reg -	16bytes
	dgr	%5,	5;arith reg -	16bytes
	dgr	%6,	6;input reg -	16bytes
	
	mov	g2,	0x4040404040404040
	movq	g5x,	g2
	vpbroadcastq	g5x,	g5x
	pand	g5x,	g6x
	psrlw	g5x,	4
	movdqu	g4x,	g5x
	psrlw	g5x,	1
	por	g4x,	g5x
	psrlw	g5x,	1
	por	g4x,	g5x
	psubb	g6x,	g4x
	mov	g2,	0x0f0f0f0f0f0f0f0f
	movq	g3,	g6x	
	pext	g1,	g3,	g2
	pextrq	g3,	g6x,	1
	pext	g3,	g3,	g2
	shl	g3,	32
	or	g1,	g3
	udgr	1
	udgr	2
	udgr	3
	udgr	4
	udgr	5
	udgr	6
%endmacro
;TODO: Fix this macro
%macro	tohexbu	2	;to uppercase hex - byte. Fast and small but less modular version.
	;output on ax
	dgr	%1,	c	;input, must be al, bl, cl or dl for high byte
	dgr	%2,	b	;arithmetic register for multiply
	;split	nibbles into two bytes in input
	mov	gch,	gcb
	shr	gcb,	4
	and	gcw,	0x0f0f
	mov	ax,	gcw
	mov	gb,	7
	sub	ax,	0x0202
	and	ax,	gcw
	and	ax,	0x0808
	mul	gb
	add	ax,	gcw
	add	ax,	0x3030
	udgr	c
	udgr	b
%endmacro
;note: alt versions that are slower. Made only for use in registers r8 to r15
;To HEX Uppercase Byte Alternative
%macro	tohexbua	3	;to uppercase hex - byte. Slow and large but more modular alt version for r8 to 15.
	dgr	%1,	a	;output
	dgr	%2,	b	;arithmatic value-holder
	dgr	%3,	c	;input, must be al, bl, cl or dl for high byte
	;split	nibbles into two bytes in input
	mov	gbb,	gcb
	shr	gcb,	4
	shl	gbw,	8
	or	gcw,	gbw
	and	gcw,	0x0f0f
	mov	gbw,	gcw
	sub	gbw,	0x0202
	and	gbw,	gcw
	and	gbw,	0x0808
	shr	gbw,	1
	mov	gaw,	gbw
	shr	gaw,	1
	or	gaw,	gbw
	shr	gaw,	1
	or	gaw,	gbw
	add	gaw,	gcw
	add	gaw,	0x3030
	udgr	a
	udgr	b
	udgr	c
%endmacro
;
%macro	tohexbua	2	;to uppercase hex - byte. Fast and small but less modular alt version for r8-15.
	;output on ax
	dgr	%1,	b	;arithmatic value-holder
	dgr	%22,	c	;input, must be al, bl, cl or dl for high byte
	;split	nibbles into two bytes in input
	mov	gbb,	gcb
	shr	gcb,	4
	shl	gbw,	8
	or	gcw,	gbw
	and	gcw,	0x0f0f
	mov	gbw,	gcw
	sub	gbw,	0x0202
	and	gbw,	gcw
	and	gbw,	0x0808
	mov	ax,	gbw
	mul	7
	add	ax,	gcw
	add	ax,	0x3030
	udgr	b
	udgr	c
%endmacro

;To HEX Lowercase Byte
%macro thexlb	3
	dgr	a,	%1	;out on gab
	dgr	b,	%2
	dgr	c,	%3	;in on gcw
	mov	gch,	gcb
	shr	gcb,	4
	and	gcw,	0x0f0f
	mov	gbw,	gcw
	sub	gbw,	0x0202
	and	gbw,	gcw
	and	gbw,	0x0808
	shr	gbw,	3
	mov	gaw,	gbw
	shl	gaw,	2
	or	gaw,	gbw
	shl	gaw,	1
	or	gaw,	gbw
	shl	gaw,	1
	or	gaw,	gbw
	add	gaw,	gcw
	add	gaw,	0x30
	udgr	a
	udgr	b
	udgr	c
%endmacro

;callable variants
%macro f_t_hex_u_b 2
F_THEXUB_%1_%2:
	thexub %1, %2
	ret
%endmacro
