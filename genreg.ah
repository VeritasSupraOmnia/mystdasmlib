;generalized registers in nasm assembly.
;Written by Keaton G.C. Hatcher

;purpose: Less headache for developing assembly macro libraries with optimized register fill.

;use - basic dgr and udgr:
;
;
;Example 1:
;
;	dgr	_reg_	rax
;
;Makes the following assignments:
;
;	g_reg_	<-	rax
;	g_reg_d	<-	eax
;	g_reg_w	<-	ax
;	g_reg_b	<-	al
;	g_reg_h	<-	ah
;
;Example 2:
;
;	dgr	a	cl
;
;Makes the following assignments:
;
;	ga	<-	rcx
;	gad	<-	ecx
;	gaw	<-	cx
;	gab	<-	cl
;	gah	<-	ch
;
;For the above examples, udgr unassigns the general register, making them output an error if used.
;This is to limit unintentional assignments and mistaken register use.
;
;	udgr	_reg_
;	udgr	a
;
;Use - Non-inline functions:
;
;
;To write modular functions using this system, please loosely follow this format when writing functions for generalized registers for improved modularity of assembly code, 
;if you are writing headers that you intend to use in many different places.
;
;Inline func example:
;%macro	some_func_name	2
;	dgr	a	%1
;	dgr	b	%2
;	;code here
;	udgr	a
;	udgr	b
;%endmacro
;
;Non-inline func declaration, based on above inline version:
;%macro	f_some_func_name	2
;f_some_func_name_%1_%2:
;	some_func_name %1 %2
;ret
;%endmacro
;
;This format allows you to redeclare the same function with different registers whenever you need them like, for example, "f_some_func_name rax r8".
;This way, you don't need to go copy-paste and edit a function whenever you need a new, callable variant using different registers.
;You can use whatever syntax you want to support the differentiation of arguments, such as "%1-%2-%3" or "%1|%2|%3", and the "f_" is just for clearly separating the inline
;and non-inline versions of the code


%define	genregs	1	;for doing conditional assembly in libraries that include both genreg and non genreg macros, because of dependency optimizing, so one can obtain kino build speeds.
;for targeting certain cpu hardware. IMPORTANT!!! MAKE SURE YOU HAVE THE CPU CAPABILITY FOR THESE SIZES
%define	use32b		0
%define	use64b		0
%define	use512		0	;avx512
%define	use256		0	;avx2
%define	use128		0	;avx

;I use this system to allow build scripts to target specific features from the command line, with a single %define
;use "%define	cpu_arch	architecture_name" to define the architecture
;valid:
;x86
;x86_64
%ifdef	cpu_arch
	%ifidni		cpu_arch	x86
		%define	use32b	1
	%elifidni	cpu_arch	x86_64
		%define	use32b	1
		%define	use64b	1
	%endif
%else
	%define	cpu_arch	x86_64		;Assumes 64 bit general registers by default unless otherwise defined
	%define	use32b	1
	%define	use64b	1
%endif

%ifdef	cpu_fset
	%ifidni			cpu_fset	avx512
		%define	use512	1
		%define	use256	1
		%define	use128	1
	%elifidni		cpu_fset	avx2
		%define	use256	1
		%define	use128	1
	%elifidni 		cpu_fset	avx
		%define	use128	1
	%endif
%else	;To change the default featureset, copy paste the features you want from above and overwrite the cpu_fset definition with the feature-set you want
	%define	cpu_fset	avx2
	%define	use256		1
	%define	use128		1
%endif
;Assumes at least avx2 feature set but sets up the preprocessor to handle different arch sizes and feature sets.
;use %define cpu_fset avx512 
;to get access to avx 512 registers
;This will lead to less debugging and easier build systems later, as avx512 is still not so common.
;Only x86_64 so far.

%macro featerror 1
	%error Register %1 is not supported by genreg buildflag cpu_fset.
%endmacro
%macro archerror 1
	%error Register %1 is not supported by genreg buildflag cpu_arch.
%endmacro

;Because stack and base pointers have distinct functions, I do not generalize them.
%macro	d_rax	1
	%if	use64b = 1
	%define	g%1	rax
	%endif
	%if	use32b = 1
	%define	g%1d	eax
	%endif
	%define	g%1w	ax
	%define	g%1b	al
	%define	g%1h	ah
%endmacro
%macro	d_rbx	1
	%if	use64b = 1
	%define	g%1	rbx
	%endif
	%if	use32b = 1	
	%define	g%1d	ebx
	%endif
	%define	g%1w	bx
	%define	g%1b	bl
	%define	g%1h	bh
%endmacro
%macro	d_rcx	1
	%if	use64b = 1
	%define	g%1	rcx
