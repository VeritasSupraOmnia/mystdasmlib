;needs genreg cstring.ah and syscall.ah included above this

%macro	newtest1 2
%push	scope
	%strcat	%%sstr	%2,	":	success"
	newstrla	%[%1s],	%%sstr
	%strcat	%%fstr	%2,	":	failure"
	newstrla	%[%1f],	%%fstr
%pop
%endmacro
