%macro	dgr 2
	%ifidni		%1,	rax
		d_rax	%2
	%elifidni	%1,	rbx
		d_rbx	%2
	%elifidni	%1,	rcx
		d_rcx	%2
	%elifidni	%1,	rdx
		d_rdx	%2
	%elifidni	%1,	rsi
		d_rsi	%2
	%elifidni	%1,	rdi
		d_rdi	%2
	%elifidni	%1,	r8
