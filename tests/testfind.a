%include	"../genreg.ah"
%include	"../syscall.ah"
%include	"../cstring.ah"
%include	"../util.ah"
%include	"../find.ah"
%include	"../hex.ah"
%include	"../regstats.ah"
global	main
section	.data
	baseregbindata	1
	basereghexdata	1
	baseregoutdata	1

	newstrla	success,	"find.ah	Test success!"
	newstrla	failure,	"find.ah	Test failure!"
	newstr		stof,		"34"
	newstr		stosw,		"fff1234f";should return found
	newstr		stosf,		"ff12ffea";should return not found
section	.code
main:	
	xor	r8,	r8
	mov	r9,	sstof
	xor	rdx,	rdx
	mov	rcx,	2
	mov	r8w,	[sstof]
	mov	rdx,	[sstosw]

	fndq	rax,	rdx,	r8,	rcx,	r9,	r10
	write	stdout,	ssuccess,	[lsuccess]
	jmp	end
fail:	
	write	stdout,	sfailure,	[lfailure]
end:	
	baseregconvm	1,	1,	xmm0,	xmm1,	xmm2,	r8
	baseregformat	1,	1,	xmm0
	write	stdout,	s_rax1,	odat_totalsize
	mov	rax,	sys_ret
	mov	rdx,	0
	syscall
