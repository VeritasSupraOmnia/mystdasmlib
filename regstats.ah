;saving of raw data from base regs
%macro	takebaseregs 1
	mov	[b_rax%1],	rax
	mov	[b_rbx%1],	rbx
	mov	[b_rcx%1],	rcx
	mov	[b_rdx%1],	rdx
	mov	[b_rbp%1],	rbp
	mov	[b_rsp%1],	rsp
	mov	[b_rdi%1],	rdi
	mov	[b_rsi%1],	rsi
	mov	[b_r8%1],	r8
	mov	[b_r9%1],	r9
	mov	[b_r10%1],	r10
	mov	[b_r11%1],	r11
	mov	[b_r12%1],	r12
	mov	[b_r13%1],	r13
	mov	[b_r14%1],	r14
	mov	[b_r15%1],	r15
	%if	use512	=	1
	mov	[b_r16%1],	r16
	mov	[b_r17%1],	r17
	mov	[b_r18%1],	r18
	mov	[b_r19%1],	r19
	mov	[b_r20%1],	r20
	mov	[b_r21%1],	r21
	mov	[b_r22%1],	r22
	mov	[b_r23%1],	r23
	mov	[b_r24%1],	r24
	mov	[b_r25%1],	r25
	mov	[b_r26%1],	r26
	mov	[b_r27%1],	r27
	mov	[b_r28%1],	r28
	mov	[b_r29%1],	r29
	mov	[b_r30%1],	r30
	mov	[b_r31%1],	r31
	%endif
%endmacro
;loading of raw data into base regs
%macro	loadbaseregs 1
	mov	rax,	[b_rax%1]
	mov	rbx,	[b_rbx%1]
	mov	rcx,	[b_rcx%1]
	mov	rdx,	[b_rdx%1]
	mov	rbp,	[b_rbp%1]
	mov	rsp,	[b_rsp%1]
	mov	rdi,	[b_rdi%1]
	mov	rsi,	[b_rsi%1]
	mov	r8,	[b_r8%1]
	mov	r9,	[b_r9%1]
	mov	r10,	[b_r10%1]
	mov	r11,	[b_r11%1]
	mov	r12,	[b_r12%1]
	mov	r13,	[b_r13%1]
	mov	r14,	[b_r14%1]
	mov	r15,	[b_r15%1]
	%if	use512	=	1
	mov	r16,	[b_r16%1]
	mov	r17,	[b_r17%1]
	mov	r18,	[b_r18%1]
	mov	r19,	[b_r19%1]
	mov	r20,	[b_r20%1]
	mov	r21,	[b_r21%1]
	mov	r22,	[b_r22%1]
	mov	r23,	[b_r23%1]
	mov	r24,	[b_r24%1]
	mov	r25,	[b_r25%1]
	mov	r26,	[b_r26%1]
	mov	r27,	[b_r27%1]
	mov	r28,	[b_r28%1]
	mov	r29,	[b_r29%1]
	mov	r30,	[b_r30%1]
	mov	r31,	[b_r31%1]
	%endif
%endmacro


;for making a static takebaseregs to call to
%macro	static_Takebaseregs 1
call_Takebaseregs:	takebaseregs	%1
	ret
%endmacro

%macro	baseregstohout	1
	;save needed regs to stack so I can restore them later
	push	rax
	sub	rsp,	32
	vmovdqu	[rsp],	ymm0
	sub	rsp,	32
	vmovdqu	[rsp],	ymm1
	sub	rsp,	32
	vmovdqu	[rsp],	ymm2
	sub	rsp,	32
	vmovdqu	[rsp],	ymm3
	
	;save rax here so I don't need to read it twice, one time to calculate it and one time to reload it on conversion completion
	movq	xmm0,	rax
	;setup vpshufb mask
	mov	rax,	0x0001020304050607
	movq	xmm3,	rax
	vpermq	ymm3,	ymm3,	0b00110011
	mov	rax,	0x08090A0B0C0D0E0F
	movq	xmm2,	rax
	vpermq	ymm2,	ymm2,	0b11001100
	vpor	ymm3,	ymm2,	ymm3

	pslldq	xmm0,	8
	movq	xmm2,	rbx
	por	xmm2,	xmm0
	tohexdqu	ymm0,	ymm1,	ymm2,	rax
	vpshufb	ymm0,	ymm0,	ymm3
	movdqu	[s_rax%1 + 4],	xmm0
	vpermq	ymm0,	ymm0,	0b01001110
	movdqu	[s_rbx%1 + 4],	xmm0
	
	movq	xmm0,	rcx
	pslldq	xmm0,	8
	movq	xmm2,	rdx
	por	xmm2,	xmm0
	tohexdqu	ymm0,	ymm1,	ymm2,	rax
	vpshufb	ymm0,	ymm0,	ymm3
	movdqu	[s_rcx%1 + 4],	xmm0
	vpermq	ymm0,	ymm0,	0b01001110
	movdqu	[s_rdx%1 + 4],	xmm0
	
	movq	xmm0,	rbp
	pslldq	xmm0,	8
	add	rsp,	136
	movq	xmm2,	rsp
	sub	rsp,	136
	por	xmm2,	xmm0
	tohexdqu	ymm0,	ymm1,	ymm2,	rax
	vpshufb	ymm0,	ymm0,	ymm3
	movdqu	[s_rbp%1 + 4],	xmm0
	vpermq	ymm0,	ymm0,	0b01001110
	movdqu	[s_rsp%1 + 4],	xmm0

	movq	xmm0,	rdi
	pslldq	xmm0,	8
	movq	xmm2,	rsi
	por	xmm2,	xmm0
	tohexdqu	ymm0,	ymm1,	ymm2,	rax
	vpshufb	ymm0,	ymm0,	ymm3
	movdqu	[s_rdi%1 + 4],	xmm0
	vpermq	ymm0,	ymm0,	0b01001110
	movdqu	[s_rsi%1 + 4],	xmm0

	movq	xmm0,	r8
	pslldq	xmm0,	8
	movq	xmm2,	r9
	por	xmm2,	xmm0
	tohexdqu	ymm0,	ymm1,	ymm2,	rax
	vpshufb	ymm0,	ymm0,	ymm3
	movdqu	[s_r8%1 + 4],	xmm0
	vpermq	ymm0,	ymm0,	0b01001110
	movdqu	[s_r9%1 + 4],	xmm0

	movq	xmm0,	r10
	pslldq	xmm0,	8
	movq	xmm2,	r11
	por	xmm2,	xmm0
	tohexdqu	ymm0,	ymm1,	ymm2,	rax
	vpshufb	ymm0,	ymm0,	ymm3
	movdqu	[s_r10%1 + 4],	xmm0
	vpermq	ymm0,	ymm0,	0b01001110
	movdqu	[s_r11%1 + 4],	xmm0

	movq	xmm0,	r12
	pslldq	xmm0,	8
	movq	xmm2,	r13
	por	xmm2,	xmm0
	tohexdqu	ymm0,	ymm1,	ymm2,	rax
	vpshufb	ymm0,	ymm0,	ymm3
	movdqu	[s_r12%1 + 4],	xmm0
	vpermq	ymm0,	ymm0,	0b01001110
	movdqu	[s_r13%1 + 4],	xmm0

	movq	xmm0,	r14
	pslldq	xmm0,	8
	movq	xmm2,	r15
	por	xmm2,	xmm0
	tohexdqu	ymm0,	ymm1,	ymm2,	rax
	vpshufb	ymm0,	ymm0,	ymm3
	movdqu	[s_r14%1 + 4],	xmm0
	vpermq	ymm0,	ymm0,	0b01001110
	movdqu	[s_r15%1 + 4],	xmm0

	;cleanup
	vmovdqu	ymm3,	[rsp]
	add	rsp,	32
	vmovdqu	ymm2,	[rsp]
	add	rsp,	32
	vmovdqu	ymm1,	[rsp]
	add	rsp,	32
	vmovdqu	ymm0,	[rsp]
	add	rsp,	32
	pop	rax
%endmacro

;for converting the bin data to hex data by reading from bin memory and outputting to hex memory
%macro	basereghconvm	6;1:outputid|2:inputid|3-5:free 16 byte regs|6:free 8byte reg
%push	scope	
	dgr	%6,	in
	dgr	%3,	out
	mov	gin,	[b_rax%2]
	tohexqu	%3,	%4,	%5,	%6
	movdqu	[h_rax%1],	goutx
	mov	gin,	[b_rbx%2]
	tohexqu	%3,	%4,	%5,	%6
