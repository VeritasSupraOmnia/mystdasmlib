%include "syscall.ah"
%include "head.ah"
%include "term.ah"
%include "cstring.ah"

c_ehdr 64, main, 8
goxy:	db ce_goxy("0","0")
cls:	db ce_clear
col:	db ce_bgc("2")
eal:	db ce_en_altbuff
dal:	db ce_di_altbuff
res:	db ce_reset
main:
	send_ccode eal, ce_en_altbuff_size
	send_ccode cls, ce_clear_size
	send_ccode goxy, ce_goxy_size
;	send_ccode col, ce_bgc_size
	read	0,		temp,	8
	send_ccode dal, ce_di_altbuff_size
;	send_ccode res, ce_reset_size
	mov		eax,	sys_ret
	xor		edi,	edi
	syscall
c_ftr
temp: resq 2
