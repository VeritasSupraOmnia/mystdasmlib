;macro library for manually creating elf headers 

;make elf and program header at the top of the program
%macro c_ehdr 3
%define	membase64	0x0040000
ehdr:
%if	%1	=	64
bits	64
	org	membase64
%else
bits	32
	org	0x08048000
%endif
ehdr:
	db	0x7f,0x45,0x4c,0x46
%if	%1	=	64
	db	0x02
%else
	db	0x01
%endif
	db	0x01
	db	0x01
	db	0x00
	dq	0x00					;e_ident_abiversion
;0x10
	dw	0x02					;e_type
	dw	0x3e					;e_machine
	dd	0x01					;e_version
%if	%1	=	64
	dq	%2
	dq	phdr - $$
	dq	0
%else
	dd	%2
	dd	phdr - $$
	dd	0
%endif
	dd	0
	dw	ehdrsize
	dw	phdrsize
	dw	1
	dw	0
	dw	0
	dw	0
ehdrsize	equ	$ - ehdr
	
phdr:
	dd	1
%if	%1	=	64
	dd	0b0111
	dq	0
	dq	$$
	dq	$$
	dq	filesize
	dq	filesize + %3	;make a stack
	dq	0x0010
%else	
	dd	0
	dd	$$
	dd	$$
	dd	filesize
	dd	filesize + %3
	dd	7
	dd	0x1000
%endif
	
phdrsize	equ	$ - phdr

%endmacro

; Create Fast Elf HeaDeR
%macro c_fehdr 1
	c_ehdr 64, %1, bss_size
%endmacro

; Make the footer to determine the filesize at the end of the file
%macro	c_ftr	0
filesize	equ	$	-	$$
filecap	equ	$
absolute	$
%endmacro

; ARGUMENT HANDLING
; Assumes these are called at the start of the program.

; Puts argc into a register
%macro	rargc	1
	mov	%1,	[rsp+8]
%endmacro

; Scratches rsi and rdi to move argc out of the stack.
%macro	margc	1
	lea	rsi,	[rsp+8]
	mov	rdi,	%1
	movsq
%endmacro

;gets argv (the meta pointer) and puts it into a register
%macro	rargv	1
	lea	%1,	[rsp+16]
%endmacro

; Does the same thing as margc but with argv
%macro margv 1
	lea rsi, [rsp+16]
	mov rdi, %1
	movsq
%endmacro 

;gets the index address of argv using the pointer in a register and puts into a register
%macro	riargvr	3
	;output - input - index
	mov	%1,	[%2+(8*%3)]
%endmacro

; integrated bss. Use these for bss reservation, instead of resb, while using custom header.
%macro bsb 2
	%ifndef startbss
		%define startbss 1
		start_bss:
	%endif
	%1:	resb %2
%endmacro
%macro bsw 2
	%ifndef startbss
		%define startbss 1
		start_bss:
	%endif
	%1:	resw %2
%endmacro
%macro bsd 2
	%ifndef startbss
		%define startbss 1
		start_bss:
	%endif
	%1:	resd %2
%endmacro
%macro bsq 2
	%ifndef startbss
		%define startbss 1
		start_bss:
	%endif
	%1:	resq %2
%endmacro

%macro e_bss 0		; must use this to end bss
	bss_size equ $-start_bss
%endmacro

; clears whole bss
%macro clear_bss 0
	mov rcx, bss_size		; size grab
	mov rax, rcx	; save for leftovers

	shr rcx, 5 		; divide by 32

	mov rdx, rcx	; to find how many leftovers
	shl rdx, 5		

	mov rdi, start_bss		; prepare for wipe
	vpxor ymm0, ymm0, ymm0

	cmp rcx, 0		; deal with small bss case
	je %%loop2_setup

%%loop:
	vmovdqu [rdi], ymm0		; wipe main
	add rdi, 32
loop %%loop

	sub rax, rdx	; find leftovers
	mov rcx, rax

%%loop2_setup:
	xor eax, eax

%%loop2:	
	mov [rdi], al
	inc rdi
loop %%loop2
	
%endmacro
