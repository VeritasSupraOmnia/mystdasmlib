;a header allowing you to pull, save, and print data in in as many registers as desired
;I think I will rename this regstate.ah instead of regstats.ah because it is intended to directly pull, save and convert register state.
;byte size of 
%define basereghexsize 256
%define baseregbinsize 128

;macros for an optimal format for mass saved data from the registers

;for outputting readable register data to console (that's why there are newline chars)
%define	outdat_offset	4

%define ohdat_linesize	21
%if	use512 = 0
	%define	ohdat_totalsize	336
	%define	oddat_totalsize 592
%else
	%define	ohdat_totalsize	672
	%define	oddat_totalsize 1184
%endif
%if	use512 = 0
	%define	osse_totalsize	624
%else
	%define	osse_totalsize	1248
%endif
%if	use512 = 0
	%define	oavx2_totalsize	1136
%else
	%define	oavx2_totalsize	2272
%endif

