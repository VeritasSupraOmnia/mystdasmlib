%include	'../cstring.ah'
%include	'../hex.ah'
%include	'../genreg.ah'
%include	'../syscall.ah'
global	main

section .data
	newstrla	failure,	"hex.ah		Test failure!"
	newstrla	success,	"hex.ah		Test success!"
	
	;testing data is as follows: first char in label is size, second is whether it is converted to or from hexadecimal, third is whether it is the test or desired result, fourth is whether output is uppercase. 
	;example1:	btt - byte to hexadecimal test 
	;example2:	qfr - quadword from hexidecimal result 

	;note: result data is always 2x the size of test data

	;test over one byte
	btt:	db	0x9A
	brtu:	dw	'9A'
	brtl:	dw	'9a'
section	.code
main:
	mov	dl,	[btt]
	xor	rsi,	rsi
	xor	rdi,	rdi
	tohexbu	rdi,	rsi,	rdx
	mov	ax,	[brtu]
	cmp	ax,	di
	jne	failure

	mov	dl,	[btt]
	xor	rsi,	rsi
	xor	rdi,	rdi
	tohexbua	rdi,	rsi,	rdx
	mov	ax,	[brtu]
	cmp	ax,	di
	jne	failure
%if	0
	mov	dl,	[btt]
	xor	rax,	rax
	xor	rdi,	rdi
	tohexbu	dl,	rdi
	mov	dx,	[brtu]
	cmp	ax,	dx
	jne	failure
%endif
	jmp	success
failure:mov	rax,	sys_write
	mov	rdi,	stdout
	mov	rsi,	sfailure
	mov	rdx,	[lfailure]
	syscall
	mov	rax,	sys_ret
	mov	rdi,	1
	syscall
success:mov	rax,	sys_write
	mov	rdi,	stdout
	mov	rsi,	ssuccess
	mov	rdx,	[lsuccess]
	syscall
	mov	rax,	sys_ret
	mov	rdi,	0
	syscall
