%include	"./syscall.ah"
%include	"./cstring.ah"
%include	"./head.ah"

;test various syscalls and syscall macros detailed in "syscall.ah"
c_ehdr	64,	main,	bss_size
newstrla fail, "test_syscall	failure!"
newstrla succ, "test_syscall	success!"
path:	db "./tests/testfile.txt",0
main:

	open_r path		; Test open to right file descriptor
	cmp rax, 3
	jne fail

	mov r14, rax	; Save file descriptor to preserved register

	seeke r14, 0	; test seek to end
	cmp rax, 64
	jne fail

	seekb r14, 0	; test seek to beginning
	cmp rax, 0
	jne fail
	
	getfilesize r14, r15
	cmp r15, 64		; test file size get
	jne fail
	cmp rax, 0		; test also returned to beginning
	jne fail

	close_fd r14	; this fd is no longer needed
	
					; Test clear_bss macro with chunk and leftover testing
	call fill_bss	; -fill_bss-
	mov eax, 0x69
	mov [other_data], al
	clear_bss
	call test_bss	; -test_bss-
	
	write stdout, ssucc, lsucc
	jmp exit

fill_bss:			; --fill_bss--
	mov rcx, bss_size
	shr rcx, 3
	mov rdi, data
	mov rax, 0x6969696969696969
 .loop:
	mov [rdi], rax
	add rdi, 8
	loop .loop
	ret

test_bss:			; --test_bss--
	mov rcx, bss_size
	shr rcx, 3
	mov rsi, data
	xor edi, edi
 .loop:
 	mov rax, [rsi]
	cmp rax, rdi
	jne fail
	add rsi, 8
	loop .loop
	ret

fail:
	write stdout, sfail, lfail

exit:
	nominal_exit
c_ftr
bsq data,	42
bsb other_data, 1
e_bss
