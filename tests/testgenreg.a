%include	'../genreg.ah'
%include	'../syscall.ah'
%include	'../cstring.ah'

;%define	cpu_arch	x86_64

global	main
section	.data
obj1:	dq	0x24ae7f34b8a0d3cc
obj2:	dq	0xabcdef0123456789
newstrla	success,	"genreg.ah:	Test success!"
newstrla	failure,	"genreg.ah:	Test failure!"

section	.code

%macro	testadd	2
	dgr	%1,	1
	dgr	%2,	2
	mov	g1,	[obj1]
	mov	g2,	[obj2]
	add	g1,	g2
	udgr	1
	udgr	2
%endmacro

main:	mov	rdi,	[obj1]
	mov	rsi,	[obj2]
	add	rdi,	rsi
	testadd	r8,	r9
	cmp	r8,	rdi
	je	success
	mov	rax,	sys_write
	mov	rdi,	stdout
	mov	rsi,	sfailure
	mov	rdx,	[lfailure]
	syscall
	mov	rax,	sys_ret
	mov	rdi,	0
	syscall
success:
	mov	rax,	sys_write
	mov	rdi,	stdout
	mov	rsi,	ssuccess
	mov	rdx,	[lsuccess]
	syscall
	mov	rax,	sys_ret
	mov	rdi,	0
	syscall
