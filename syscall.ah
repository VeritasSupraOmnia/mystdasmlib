;syscalls for linux
%define	libsyscall	1

;-1 for return checking
%define	err		0xffffffffffffffff

;standard file descriptions
%define	stdin		0
%define	stdout		1
%define	stderr		2

;standard file access values
%define	readonly	0
%define	writeonly	1
%define	readwrite	2

;all sys_ functions put ther id numbers (0 for sys_read, 1 for sys_write, etc) into rax and are called with the syscall instruction
%define	sys_read	0	;rdi:file descriptor	rsi:char buffer address	rdx:byte count
%define	sys_write	1	;rdi:fd			rsi:char buffer address	rdx:byte count
%define	sys_open	2	;rdi:filename address	rsi:flags
%define	sys_close	3	;rdi:file descriptor
%define	sys_mmap	9
%define sys_mumap	11
%define	sys_brk		12	;rdi:bytes to make brk
%define sys_pipe	22	;rdi:pointer to double quadword for pipe read and write file descripter
%define sys_exec	59	;rdi:cmd char array pnt
%define	sys_ret		60	;rdi:return value
%define	sys_time	201	;rdi;memory location to put time value - gets seconds since epoch

;push all quadword registers
%macro	pushaq	0
push	rax
push	rbx
push	rcx
push	rbp
push	rsp
push	rdx
push	rdi
push	rsi
push	r8
push	r9
push	r10
push	r11
push	r12
push	r13
push	r14
push	r15
%endmacro
;pop all quadword registers
%macro	popaq	0
pop	r15
pop	r14
pop	r13
pop	r12
pop	r11
pop	r10
pop	r9
pop	r8
pop	rsi
pop	rdi
pop	rdx
pop	rsp
pop	rbp
pop	rcx
pop	rbx
pop	rax
%endmacro


;easier write setup
;use:	write	stout,	charbuffer,	[length_charbuffer]
%macro	write	3
mov	rax,	sys_write
mov	rdi,	%1
mov	rsi,	%2
mov	rdx,	%3
syscall
%endmacro

;cwrite	-	CleanWRITE
;same as above but slower, due to popping and pushing registers, but you can insert it anywhere as long as you don't stack overflow
%macro	cwrite	3
pushaq
mov	rax,	sys_write
mov	rdi,	%1
mov	rsi,	%2
mov	rdx,	%3
syscall
popaq
%endmacro

;easier read setup
;use	read	stdin,	charbuffer,	[num_chars_to_read]
%macro	read	3
mov	rax,	sys_read
mov	rdi,	%1
mov	rsi,	%2
mov	rdx,	%3
syscall
%endmacro

%macro	pipedat 0
	pread:	dq	0
	pwrite:	dq	0
%endmacro
