%macro	udgr	1
	%ifdef	g%1
		%undef g%1
		%undef g%1d
		%undef g%1w
		%undef g%1b
		%ifdef	g%1h
			%undef g%1h
		%endif
	%elifdef	g%1d
		%if use64b = 1
			%undef g%1
		%endif
		%undef	g%1d
		%undef	g%1w
		%undef	g%1b
		%ifdef	g%1h
			%undef	g%1h
		%endif
	%elifdef	g%1w
		%if use64b = 1
			%undef	g%1
		%endif
		%if use32b = 1
			%undef	g%1d
		%endif
		%undef	g%1w
		%undef	g%1b
		%ifdef	g%1h
			%undef	g%1h
		%endif
	%elifdef	g%1x
		%undef	g%1x
		%if use256 = 1
			%undef	g%1y
		%endif
		%if use512 = 1
			%undef g%1z
		%endif
	%elifdef g%1z
		%undef	g%1x
		%undef	g%1y
		%undef	g%1z
	%endif
%endmacro

;runtime register selection
;Using a word-sized register-busy switch and special generalized macros, one can keep track of which register is in use.
;Therefor, one can programmatically select which registers to use during runtime, so as to not need to worry as much about specific registers all the time, but how many registers of each type one has available.
