; library containing macros pertaining to linux frame buffer manipulaition.

%macro dfbdevpath 1
	; path to fb device
	%push context
	%defstr %%dev %[%1]
	%1: db "/dev/",%%dev,0x00
	%pop
%endmacro

%macro square_from_line 2
	; %1 is x offset %2 is y offset
	; height and width are both 8 pixels
	; scratches rdi
	mov rdi, buffer+(%2*1920*4)+(%1*4)
	vmovdqu ymm0, [green]
	vmovdqu [rdi], ymm0
%rep 7
	add rdi, (1920*4)
	vmovdqu [rdi],ymm0
%endrep
%endmacro

; for setting a single pixel in data
%define spx(color) 0xffffffff&color
; for setting 4 double words at a time
%define s4px(first,second,third,fourth) spx(first),spx(second),spx(third),spx(fourth)

;declare 4x 8y pixel font - 16x8 bytes
%macro dfont4by8 3
%push scope
	%define %%name %1
	%define %%F %2
	%define %%B %3
%[%%name]_a:	dd 	s4px(%%B,%%B,%%B,%%B)
				dd 	s4px(%%B,%%B,%%B,%%B)
				dd	s4px(%%F,%%F,%%F,%%B)
				dd	s4px(%%B,%%B,%%B,%%F)
				dd	s4px(%%B,%%F,%%F,%%F)
				dd	s4px(%%F,%%B,%%B,%%F)
				dd	s4px(%%F,%%B,%%B,%%F)
				dd	s4px(%%B,%%F,%%F,%%B)

%[%%name]_b:	dd 	s4px(%%F,%%B,%%B,%%B)
				dd 	s4px(%%F,%%B,%%B,%%B)
				dd	s4px(%%F,%%B,%%B,%%B)
				dd	s4px(%%F,%%B,%%B,%%B)
				dd	s4px(%%F,%%F,%%F,%%B)
				dd	s4px(%%F,%%B,%%B,%%F)
				dd	s4px(%%F,%%B,%%B,%%F)
				dd	s4px(%%B,%%F,%%F,%%B)
%pop
%endmacro

%macro draw_w4by8_font 4
%push scope
	%define %%line_size %3
	%define %%X_loc %1
	%define %%Y_loc %2
	%define %%target %4
	; same as above but height is 8 and width is 4
	; also rsi is scratched and increased by 16
	mov rdi, buffer+(%%Y_loc*%%line_size*4)+(%%X_loc*4)
	mov rsi, %%target
	vmovdqu xmm0, [rsi]
	vmovdqu [rdi], xmm0
%rep 7
	add rdi, (1920*4)
	add rsi, 16
	vmovdqu xmm0, [rsi]
	vmovdqu [rdi],xmm0
%endrep
%pop
%endmacro
