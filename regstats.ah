	vmovdqu	ymm3,	[rsp]
	add	rsp,	32
	vmovdqu	ymm2,	[rsp]
	add	rsp,	32
	vmovdqu	ymm1,	[rsp]
	add	rsp,	32
	vmovdqu	ymm0,	[rsp]
	add	rsp,	32
	pop	rax

%endmacro
