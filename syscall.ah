;syscalls for linux
%define	libsyscall	1

;-1 for return checking
%define	err		0xffffffffffffffff

;standard file descriptions
%define	stdin		0
%define	stdout		1
%define	stderr		2

;standard file access values
%define	readonly	0
%define	writeonly	1
%define	readwrite	2
%define create		0x40
%define append		0x0400
%define	truncate	0x0200

;standard file access modes
%define	rwxu		0x0700
%define	ru		0x0400
%define	wu		0x0200
%define	xu		0x0100
%define	rwxg		0x0070
%define	rg		0x0040
%define	wg		0x0020
%define	xg		0x0010
%define	rwxo		0x0007
%define	ro		0x0004
%define	wo		0x0002
%define	xo		0x0001
%define	setuserid	0x4000
%define	setgroupid	0x2000
%define	stickybit	0x1000

;standard linux signals
%define	SIGKILL	0x09
%define	SIGCHLD	0x11
%define	SIGCONT	0x12

;sys_clone bitmask values
%define	clone_vm	0x0100
%define	clone_io	0x80000000
%define	clone_files	0x0400
%define	clone_vfork	0x004000
%define	clone_thread	0x010000

;sys_wait flags
%define	wexited	0x04

;sys_mmap prot states
%define	prot_read	0x01
%define	prot_write	0x02
%define	prot_exec	0x04
%define	prot_none	0x00

;sys_mmap flags
%define	map_shared	0x01
%define	map_private	0x02
%define	map_fixed	0x10
%define	map_populate	0x8000

;all sys_ functions put ther id numbers (0 for sys_read, 1 for sys_write, etc) into rax and are called with the syscall instruction
%define	sys_read	0	;rdi:file descriptor	rsi:char buffer address	rdx:byte count
%define	sys_write	1	;rdi:fd			rsi:char buffer address	rdx:byte count
%define	sys_open	2	;rdi:filename address	rsi:flags
%define	sys_close	3	;rdi:file descriptor
%define	sys_stat	4	;rdi:file descriptor
%define	sys_fstat	5	;rdi:file descriptor
%define	sys_lstat	6	;rdi:file descriptor
%define	sys_poll	7	;rdi:file descriptor
%define	sys_lseek	8	;rdi:file descriptor
%define	sys_mmap	9
%define	sys_mprotect	10
%define sys_mumap	11
%define	sys_brk		12	;rdi:bytes to make brk
%define	sys_sigaction		13
%define	sys_sigprocmask		14
%define	sys_sigreturn		15
%define	sys_ioctl		16
%define sys_pread	17	;rdi:fd	rsi:char buffer address	rdx:count	r10:offset
%define sys_pwrite	18	;rdi:fd	rsi:char buffer address	rdx:count	r10:offset
%define	sys_readv	19
%define	sys_writev	20
%define	sys_access	21
%define sys_pipe	22	;rdi:pointer to double quadword for pipe read and write file descripter
%define	sys_select	23
%define	sys_shed_yeild	24
%define	sys_mremap	25
%define	sys_msync	26
%define	sys_mincore	27
%define	sys_madvise	28
%define	sys_shmget	29
%define	sys_shmat	30
%define	sys_shmctl	31
%define	sys_dup	32
%define	sys_dup2	33
%define	sys_pause	34
%define	sys_nanosleep	35
%define	sys_getitimer	36
%define	sys_alarm	37
%define	sys_setitimer	38
%define	sys_getpid	39
%define	sys_sendfile	40
%define	sys_socket	41
%define	sys_connect	42
%define	sys_accept	43
%define	sys_sendto	44
%define	sys_recvfrom	45
%define	sys_sendmsg	46
%define	sys_recvmsg	47
%define	sys_shutdown	48
%define	sys_bind	49
%define	sys_listen	50
%define	sys_getsocketname	51
%define	sys_getpeername	52
%define	sys_socketpair	53
%define	sys_setsockopt	54
%define	sys_getsockopt	55
%define sys_clone	56	;rdi: flags	rsi: location of top of child's stack	xor the other shit
%define sys_fork	57
%define sys_vfork	58
%define sys_exec	59	;rdi:cmd char array pnt
%define	sys_ret		60	;rdi:return value
%define	sys_wait4	61
%define sys_kill	62	;rdi:pid to send signal to	rsi:signal to send (9 to end unconditionally)
%define sys_uname	63
%define sys_semget	64
%define sys_semop	65
%define sys_semctl	66
%define sys_shmdt	67
%define sys_msgget	68
%define sys_msgsnd	69
%define sys_msgrcv	70
%define sys_msgctl	71
%define sys_fcntl	72
%define sys_flock	73
%define sys_fsync	74
%define sys_fdatasync	75
%define sys_truncate	76
%define sys_ftruncate	77
%define sys_getdents	78
%define sys_getcwd	79
%define sys_chdir	80
%define sys_fchdir	81
%define sys_rename	82
%define sys_mkdir	83
%define sys_rmdir	84
%define sys_creat	85
%define sys_link	86
%define sys_unlink	87
%define sys_symlink	88
%define sys_readlink	89
%define sys_chmod	90
%define sys_fchmod	91
%define sys_chown	92
%define sys_fchown	93
%define sys_lchown	94
%define sys_umask	95
%define sys_gettimeofday	96
%define sys_getrlimit	97
%define sys_getusage	98
%define sys_sysinfo	99
%define sys_times	100
%define sys_ptrace	101
%define sys_getuid	102
%define sys_syslog	103
%define sys_getgid	104
%define sys_setuid	105
%define sys_setgid	106
%define sys_geteuid	107
%define sys_getegid	108
%define sys_setpgid	109
%define	sys_getppid	110
%define	sys_gettid	186	
%define	sys_tkill	200	;rdi:tid	rsi:signal
%define	sys_time	201	;rdi;memory location to put time value - gets seconds since epoch
%define sys_waitid	247

;easier write setup
;use:	write	stout,	charbuffer,	[length_charbuffer]
%macro	write	3
mov	rax,	sys_write
mov	rdi,	%1
mov	rsi,	%2
mov	rdx,	%3
syscall
%endmacro

;easier read setup
;use	read	stdin,	charbuffer,	[num_chars_to_read]
%macro	read	3
mov	rax,	sys_read
mov	rdi,	%1
mov	rsi,	%2
mov	rdx,	%3
syscall
%endmacro

%macro	pread	4
mov	rax,	sys_pread
mov	rdi,	%1;file descriptor
mov	rsi,	%2;input buffer address
mov	rdx,	%3;count
mov	r10,	%4;offset
syscall
%endmacro
%macro	pwrite	4
mov	rax,	sys_pwrite
mov	rdi,	%1
mov	rsi,	%2
mov	rdx,	%3
mov	r10,	%4
syscall
%endmacro

%macro	brk	1
	mov	rax,	sys_brk
	mov	rdi,	%1
	syscall
%endmacro

%macro	getpid	0
	mov	rax,	sys_getpid
	syscall
%endmacro
%macro	getppid	0
	mov	rax,	sys_getppid
	syscall
%endmacro
%macro	gettid	0
	mov	rax,	sys_gettid
	syscall
%endmacro
;quick clone for splitting into another thread
%macro	clonevm 1
	mov	rax,	sys_clone
	mov	rdi,	clone_vm | clone_thread | clone_files | clone_io
	mov	rsi,	%1
	syscall
%endmacro

%macro	pipedat 0
	pread:	dq	0
	pwrite:	dq	0
%endmacro
