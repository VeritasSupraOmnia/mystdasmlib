;macro library for manually creating elf headers 

;make elf and program header at the top of the program
%macro c_ehdr 3
%define	membase64	0x0040000
ehdr:
%if	%1	=	64
bits	64
	org	membase64
%else
bits	32
	org	0x08048000
%endif
ehdr:
	db	0x7f,0x45,0x4c,0x46
%if	%1	=	64
	db	0x02
%else
	db	0x01
%endif
	db	0x01
	db	0x01
	db	0x00
	dq	0x00					;e_ident_abiversion
;0x10
	dw	0x02					;e_type
	dw	0x3e					;e_machine
	dd	0x01					;e_version
%if	%1	=	64
	dq	%2
	dq	phdr - $$
	dq	0
%else
	dd	%2
	dd	phdr - $$
	dd	0
%endif
	dd	0
	dw	ehdrsize
	dw	phdrsize
	dw	1
	dw	0
	dw	0
	dw	0
ehdrsize	equ	$ - ehdr
	
phdr:
	dd	1
%if	%1	=	64
	dd	0b0111
	dq	0
	dq	$$
	dq	$$
	dq	filesize
	dq	filesize + %3	;make a stack
	dq	0x0010
%else	
	dd	0
	dd	$$
	dd	$$
	dd	filesize
	dd	filesize + %3
	dd	7
	dd	0x1000
%endif
	
phdrsize	equ	$ - phdr

%endmacro

;make the footer to determine the filesize at the end of the file
%macro	c_ftr	0
filesize	equ	$	-	$$
filecap	equ	$
absolute	$
%endmacro

;ARGUMENT HANDLING
;Assumes these are called at the start of the program.

;puts argc into a register
%macro	rargc	1
	mov	%1,	[rsp]
%endmacro
;scratches rsi and rdi and does a 
%macro	margc	1
	mov	rsi,	rsp
	mov	rdi,	%1
	movsq
%endmacro
;gets argv (the meta pointer) and puts it into a register
%macro	rargv	1
	lea	%1,	[rsp+8]
%endmacro
;gets the index address of argv using the pointer in a register and puts into a register
%macro	riargvr	3
	;output - input - index
	mov	%1,	[%2+(8*%3)]
%endmacro


; use this define in the last argument of the header creation macro and the following macro
; to automatically count how much bss memory you need to reserve, and automatically reserve
; it in the header.
%macro addbss 2
	%ifndef startbss
		%define startbss 1
		start_bss:
	%endif
	%1:	resb %2
%endmacro
%macro endbss 0
	bss_size equ $-start_bss
%endmacro
