; key based input in asm

; bss termios structure
%macro termios_struct 1
%1:
%1.c_iflag: resd 1
%1.c_oflag: resd 1
%1.c_cflag: resd 1
%1.c_lflag: resd 1
%1.c_line resb 1
%1.c_cc resb 19
%endmacro
%define termios_struct_size 46

%macro get_termios 1
	mov eax, 16
	xor	edi, edi
	mov esi, 0x5401	; TCGETS
	mov rdx, %1
	syscall
%endmacro
%macro set_termios 1
	mov eax, 16
	xor	edi, edi
	mov esi, 0x5402	; TCSETS
	mov rdx, %1
	syscall
%endmacro

%macro set_cannon 1
	or [%1.c_lflag], dword 0x02
%endmacro
%macro set_noncannon 1
	xor [%1.c_lflag], dword 0x02
%endmacro
%macro set_echo 1
	or [%1.c_lflag], dword 0x08
%endmacro
%macro set_noecho 1
	xor [%1.c_lflag], dword 0x08
%endmacro
