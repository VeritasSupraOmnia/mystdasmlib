%include	"./syscall.ah"
%include	"./head.ah"

;declare standard, 64 bit elf header with entry-point "main"
c_ehdr	64,	main,	0

;my god why did I declare this after the main label. I swear to god, I was tearing my hair out trying to figure out why I was segfaulting. I am a fucking brainlet sometimes.
%define		msucc	"head.ah		Test success!"
%define		mfail	"head.ah		Test failure!"
%strlen		len	msucc
ssucc:	db	msucc,0x0A
sfail:	db	mfail,0x0A

fail:
	printbuff	sfail,	len+1
	jmp end
main:	
	;testing command line arguments

	;data section is tested here
	printbuff	ssucc,	len+1
end:
	mov	rax,	sys_ret
	mov	rdi,	0
	syscall

;declare footer, just finds file end address for header generation
c_ftr
