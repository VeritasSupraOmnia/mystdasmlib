%include	'./head.ah'
%include	'./genreg.ah'
%include	'./syscall.ah'
%include	'./cstring.ah'

c_ehdr	64,	main,	0
obj1:	dq	0x24ae7f34b8a0d3cc
obj2:	dq	0xabcdef0123456789
newstrla	success,	"genreg.ah:	Test success!"
newstrla	failure,	"genreg.ah:	Test failure!"

%macro	testadd	2
%push	scope
	dgr	%1,	1
	dgr	%2,	2
	mov	g1,	[obj1]
	mov	g2,	[obj2]
	add	g1,	g2
%pop
%endmacro

main:	
	mov	rdi,	[obj1]
	mov	rsi,	[obj2]
	add	rdi,	rsi
	testadd	r8,	r9
	cmp	r8,	rdi
	jne	fail

	mov	rdi,	[obj1]
	mov	rsi,	[obj2]
	add	rdi,	rsi
	%define targlist r8, r9
	testadd	%[targlist]
	cmp	r8,	rdi
	jne	fail
%if 0
	regsize	rax,	test1
	mov	rax,	test1
	mov	rdx,	8
	cmp	rax,	rdx
	jne	fail

	regsize	ymm1,	test2
	mov	rax,	test2
	mov	rdx,	32
	cmp	rax,	rdx
	jne	fail

	regsize	ef1,	test3
	mov	rax,	test3
	mov	rdx,	0
	cmp	rax,	rdx
	jne	fail

%endif
	
	mov	rax,	sys_write
	mov	rdi,	stdout
	mov	rsi,	ssuccess
	mov	rdx,	lsuccess
	syscall
	jmp	end
fail:	mov	rax,	sys_write
	mov	rdi,	stdout
	mov	rsi,	sfailure
	mov	rdx,	lfailure
	syscall
end:
	mov	rax,	sys_ret
	mov	rdi,	0
	syscall
c_ftr
