;needs genreg.ah
%define	hex	1
;To HEX Uppercase Byte
	
%macro	tohexbu	3	;to uppercase hex - byte. Slow and large but more modular version.
	%push	scope
	dgr	%1,	a	;output
	dgr	%2,	b	;arithmatic value-holder
	dgr	%3,	c	;input, must be al, bl, cl or dl for high byte
	;split	nibbles into two bytes in input
	mov	gch,	gcb
	shr	gcb,	4
	and	gcw,	0x0f0f
	mov	gbw,	gcw
	sub	gbw,	0x0202
	and	gbw,	gcw
	and	gbw,	0x0808
	shr	gbw,	1
	mov	gaw,	gbw
	shr	gaw,	1
	or	gaw,	gbw
	shr	gaw,	1
	or	gaw,	gbw
	add	gaw,	gcw
	add	gaw,	0x3030
	%pop
%endmacro

;From DEX Uppercase Byte
%macro	frhexbu	3
	%push	scope
	dgr	%1,	1;output
	dgr	%2,	2;arithmetic reg
	dgr	%3,	3;input - this is a word in size
	
	mov	g2w,	g3w
	and	g2w,	0x4040
	shr	g2w,	4
	mov	g1w,	g2w
	shr	g1w,	1
	or	g2w,	g1w
	shr	g1w,	1
	or	g2w,	g1w
	sub	g3w,	g2w
	ror	g3w,	8
	mov	g2w,	0x0f0f
	pext	g1d,	g3d,	g2d
	%pop
%endmacro

%macro	tohexdu 3
	%push	scope
	dgr	%1,	1;output	-	8 bytes
	dgr	%2,	2;arithmetic	-	8 bytes
	dgr	%3,	3;input		-	4 bytes
	
	mov	g2,	0x0f0f0f0f0f0f0f0f
	pdep	g1,	g3,	g2
	mov	g2,	g1
	mov	g3,	0x0202020202020202
	sub	g2,	g3
	mov	g3,	0x0808080808080808
	and	g2,	g3
	and	g2,	g1
	shr	g2,	1
	mov	g3,	0x3030303030303030
	or	g1,	g3
	mov	g3,	g2
	shr	g3,	1
	or	g2,	g3
	shr	g3,	1
	or	g2,	g3
	add	g1,	g2
	bswap	g1
	%pop
%endmacro
%macro	frhexdu	3
	%push	scope
	dgr	%1,	1;output	-	4 bytes
	dgr	%2,	2;arithmetic	-	8 bytes
	dgr	%3,	3;input		-	8 bytes
	
	mov	g2,	0x4040404040404040
	and	g2,	g3
	shr	g2,	4
	mov	g1,	g2
	shr	g1,	1
	or	g2,	g1
	shr	g1,	1
	or	g2,	g1
	sub	g3,	g2
	mov	g2,	0x0f0f0f0f0f0f0f0f
	bswap	g3
	pext	g1,	g3,	g2
	
	%pop
%endmacro

%macro	tohexqu	4
	%push	scope
	dgr     %1,     1;output        -       16 byte
	dgr     %2,     2;bitmask       -       16 byte
	dgr     %3,     3;arithmetic    -       16 byte
	dgr     %4,     4;input and broadcast loader -  8 byte
	bswap   g4
	movq    g3x,    g4
	pxor    g2x,    g2x
	vpunpcklbw      g3x,    g2x,    g3x
	movdqu  g2x,    g3x
	psrlw   g2x,    12
	por     g3x,    g2x
	mov     g4,     0x0f0f0f0f0f0f0f0f
	movq    g2x,    g4
	vpbroadcastb    g2x,    g2x
	pand    g3x,    g2x
	mov     g4,     0x0909090909090909
	movq    g2x,    g4
	vpbroadcastq    g2x,    g2x
	vpcmpgtb        g1x,    g3x,    g2x
	mov     g4b,    0xf8
	movq    g2x,    g4
	vpbroadcastb    g2x,    g2x
	pand    g2x,    g1x
	psubb   g1x,    g2x
	paddb   g1x,    g3x
	mov     g4b,    0x30
	movq    g2x,    g4
	vpbroadcastb    g2x,    g2x
	paddb   g1x,    g2x
	%pop
%endmacro
%macro	frhexqu	6
	%push	scope
	dgr   	%1,     1;output reg-   8bytes
	dgr     %2,     2;mask reg  -   8bytes
	dgr     %3,     3;cross reg -   8bytes
	dgr     %4,     4;arith reg -   16bytes
	dgr     %5,     5;arith reg -   16bytes
	dgr     %6,     6;input reg -   16bytes
	mov     g2,     0x4040404040404040
	movq    g5x,    g2
	vpbroadcastq    g5x,    g5x
	pand    g5x,    g6x
	psrlw   g5x,    4
	movdqu  g4x,    g5x
	psrlw   g5x,    1
	por     g4x,    g5x
	psrlw   g5x,    1
	por     g4x,    g5x
	psubb   g6x,    g4x
	mov     g2,     0x0f0f0f0f0f0f0f0f
	movq    g3,     g6x
	pext    g1,     g3,     g2
	pextrq  g3,     g6x,    1
	pext    g2,     g3,     g2
	shl     g2,     32
	or      g1,     g2
	mov     g2,     g1
	mov     g3,     0xf0f0f0f0f0f0f0f0
	shr     g2,     4
	shl     g1,     4
	and     g1,     g3
	shr     g3,     4
	and     g2,     g3
	or      g1,     g2
	bswap   g1
	%pop
%endmacro
%macro	frhexql	6
	%push	scope
	dgr   	%1,     1;output reg-   8bytes
	dgr     %2,     2;mask reg  -   8bytes
	dgr     %3,     3;cross reg -   8bytes
	dgr     %4,     4;arith reg -   16bytes
	dgr     %5,     5;arith reg -   16bytes
	dgr     %6,     6;input reg -   16bytes
	mov     g2b,     0x60
	movq    g5x,    g2
	vpbroadcastb    g5x,    g5x
	vpand   g4x,	g5x,    g6x
	pcmpeqb	g5x,	g4x
	mov	g2b,	0x27
	movq	g4x,	g2
	vpbroadcastb	g4x,	g4x
	pand	g5x,	g4x
	psubb   g6x,    g5x
	mov     g2b,     0x0f
	movq	g4x,	g2
	vpbroadcastb	g4x,	g4x
	pand	g6x,	g4x
	movdqu	g5x,	g6x
	psrldq	g5x,	1
	psllw	g6x,	4
	mov	g2,	0x0E0C0A0806040200
	movq	g4x,	g2
	pshufb	g6x,	g4x
	pshufb	g5x,	g4x
	por	g6x,	g5x
	movq	g1,	g6x
	bswap	g1
	%pop
%endmacro
%macro	frhexdqu	6
	%push	scope
	dgr   	%1,     1;output reg-   16bytes
	dgr     %2,     2;mask reg  -   8bytes
	dgr     %3,     3;cross reg -   16bytes
	dgr     %4,     4;arith reg -   16bytes
	dgr     %5,     5;arith reg -   16bytes
	dgr     %6,     6;input reg -   16bytes
	mov     g2b,     0x40
	movd    g5x,    g2d
	vpbroadcastb    g5y,    g5x
	vpand	g4y,	g5y,	g6y
	vpcmpeqb	g5y,	g4y,	g5y
	mov	g2b,	0x07
	movd	g4x,	g2d
	vpbroadcastb	g4y,	g4x
	vpand	g5y,	g5y,	g4y
	vpsubb	g1y,	g6y,	g5y
	mov	g2w,	0x000f
	movd	g5x,	g2d
	vpbroadcastw	g5y,	g5x
	vpand	g3y,	g1y,	g5y
	vpsllw	g5y,	g5y,	8
	vpand	g1y,	g1y,	g5y
	vpsllw	g3y,	g3y,	12
	vpor	g1y,	g1y,	g3y
	mov	g2,	0x01030507090B0D0F
	movq	g3x,	g2
	vpermq	g3y,	g3y,	0b10001000
	vpshufb	g1y,	g1y,	g3y
	vpermq	g1y,	g1y,	0b11111000
	%pop
%endmacro
;converts 16 bytes of binary to 32 bytes of hex characters
%macro	tohexdqu	4
	%push	scope
	dgr     %1,     1;output	-	32 byte
	dgr     %2,     2;bitmask	-	32 byte
	dgr     %3,     3;input binary	-	16 byte
	dgr     %4,     4;bitmask loader-	8 byte

	;I used to use the vpunpck instructions here to split up the 16 bytes into 32.
	vpmovzxbw	g3y,	g3x
	vpsllw	g2y,	g3y,    4
	mov     g4w,    0x0f00
	movd    g1x,    g4d
	vpbroadcastw    g1y,    g1x
	vpand   g2y,    g2y,	g1y
	vpsrlw	g1y,	8
	vpand   g3y,    g3y,	g1y
	vpor     g3y,    g2y,	g3y
	mov	g4,	0x08090A0B0C0D0E0F
	movq	g2x,	g4
	mov	g4,	0x0001020304050607
	pinsrq	g2x,	g4,	1
	vperm2i128	g2y,	g2y,	g2y,	0
	vpshufb	g3y,	g3y,	g2y
	mov     g4b,	0x09
	movd    g2x,    g4d
	vpbroadcastb    g2y,    g2x
	vpcmpgtb        g1y,    g3y,    g2y
	mov     g4b,    0x07
	movd    g2x,    g4d
	vpbroadcastb    g2y,    g2x
	vpand	g1y,    g1y,	g2y
	vpaddb	g1y,	g1y,	g3y
	mov     g4b,    0x30
	movd    g2x,    g4d
	vpbroadcastb    g2y,    g2x
	vpaddb   g1y, 	g1y,	g2y
	%pop
%endmacro
;just a reverse of tohexdqu
%macro	tohexdqur	4
	%push	scope
	dgr     %1,     1;output	-	32 byte
	dgr     %2,     2;bitmask	-	32 byte
	dgr     %3,     3;input binary	-	16 byte
	dgr     %4,     4;bitmask loader-	8 byte
	
	vpmovzxbw	g3y,	g3x
	vpsllw	g2y,	g3y,	4
	mov     g4w,	0x0f00
	movd    g1x,    g4d
	vpbroadcastw    g1y,    g1x
	vpand   g2y,    g2y,	g1y
	vpsrlw	g1y,	8
	vpand   g3y,    g3y,	g1y
	vpor     g3y,	g2y,	g3y
	mov	g4,	0x0607040502030001
	movq	g2x,	g4
	mov	g4,	0x0E0F0C0D0A0B0809
	pinsrq	g2x,	g4,	1
	vperm2i128	g2y,	g2y,	g2y,	0
	vpshufb	g3y,	g3y,	g2y
	mov     g4b,     0x09
	movd    g2x,    g4d
	vpbroadcastb    g2y,    g2x
	vpcmpgtb        g1y,    g3y,    g2y
	mov     g4b,    0x07
	movd    g2x,    g4d
	vpbroadcastb    g2y,    g2x
	vpand	g1y,    g1y,	g2y
	vpaddb	g1y,	g1y,	g3y
	mov     g4b,    0x30
	movd    g2x,    g4d
	vpbroadcastb    g2y,    g2x
	vpaddb   g1y, 	g1y,	g2y
	%pop
%endmacro

;to setup for mass conversion without constant assignment
%macro	tohexdqur_setup 6
%push	scope
	;5 free mask registers and a free general register
	dgr	%1,	1;and mask
	dgr	%2,	2;pshuf mask
	dgr	%3,	3;0x09 mask
	dgr	%4,	4;0x07mask
	dgr	%5,	5;0x30mask
	dgr	%6,	load;clobbered
	mov	gloadw,	0x0f00
	movd	g1x,	gloadd
	vpbroadcastw	g1y,	g1x
	mov	gload,	0x0607040502030001
	movq	g2x,	gload
	mov	gload,	0x0E0F0C0D0A0B0809
	pinsrq	g2x,	gload,	1
	vperm2i128	g2y,	g2y,	g2y,	0
	mov	gloadb,	0x09
	movd	g3x,	gloadd
	vpbroadcastb	g3y,	g3x
	mov	gloadb,	0x07
	movd	g4x,	gloadd
	vpbroadcastb	g4y,	g4x
	mov	gloadb,	0x30
	movd	g5x,	gloadd
	vpbroadcastb	g5y,	g5x
%pop
%endmacro
;mass conversion without constant assignment - assuming the proper masks are in the proper registers
%macro	tohexdqur_assume 7
%push	scope
	;output and input registers and 5 specificly ordered mask registers
	dgr	%1,	out;clobbered
	dgr	%2,	in;clobbered
	dgr	%3,	m1;and mask
	dgr	%4,	m2;pshuf mask
	dgr	%5,	m3;0x09mask
	dgr	%6,	m4;0x07mask
	dgr	%7,	m5;0x30mask
	vpmovzxbw	giny,	ginx;spread out input
	vpsllw	gouty,	giny,	4;split it up and offset it
	vpand   gouty,    gouty,	gm1y;and one register with and mask
	vpsrlw	gm1y,	8
	vpand   giny,    giny,	gm1y;and other register with and mask
	vpsllw	gm1y,	8;revert it back for the next loop
	vpor	gouty,	giny,	gouty;combine the two registers
	vpshufb	gouty,	gouty,	gm2y;shuffle bytes around
	vpcmpgtb        giny,    gouty,    gm3y
	vpand	giny,    giny,	gm4y
	vpaddb	gouty,	gouty,	giny
	vpaddb	gouty,	gouty,	gm5y
%pop
%endmacro
;same as above but with pointer input
%macro	tohexdqur_min_assume 8
%push	scope
	;output and input registers and 5 specificly ordered mask registers
	dgr	%1,	out;clobbered
	dgr	%2,	in;clobbered
	;%3 is the memory input
	dgr	%4,	m1;and mask
	dgr	%5,	m2;pshuf mask
	dgr	%6,	m3;0x09mask
	dgr	%7,	m4;0x07mask
	dgr	%8,	m5;0x30mask
	vpmovzxbw	giny,	[%3];spread out input
	vpsllw	gouty,	giny,	4;split it up and offset it
	vpand   gouty,    gouty,	gm1y;and one register with and mask
	vpsrlw	gm1y,	8
	vpand   giny,    giny,	gm1y;and other register with and mask
	vpsllw	gm1y,	8;revert it back for the next loop
	vpor	gouty,	giny,	gouty;combine the two registers
	vpshufb	gouty,	gouty,	gm2y;shuffle bytes around
	vpcmpgtb        giny,    gouty,    gm3y
	vpand	giny,    giny,	gm4y
	vpaddb	gouty,	gouty,	giny
	vpaddb	gouty,	gouty,	gm5y
%pop
%endmacro
;same as above but with pointer output
%macro	tohexdqur_mout_assume 8
%push	scope
	;output and input registers and 5 specificly ordered mask registers
	dgr	%1,	out;clobbered
	dgr	%2,	in;clobbered
	;%3 is the memory output
	dgr	%4,	m1;and mask
	dgr	%5,	m2;pshuf mask
	dgr	%6,	m3;0x09mask
	dgr	%7,	m4;0x07mask
	dgr	%8,	m5;0x30mask
	vpmovzxbw	giny,	ginx;spread out input
	vpsllw	gouty,	giny,	4;split it up and offset it
	vpand   gouty,    gouty,	gm1y;and one register with and mask
	vpsrlw	gm1y,	8
	vpand   giny,    giny,	gm1y;and other register with and mask
	vpsllw	gm1y,	8;revert it back for the next loop
	vpor	gouty,	giny,	gouty;combine the two registers
	vpshufb	gouty,	gouty,	gm2y;shuffle bytes around
	vpcmpgtb        giny,    gouty,    gm3y
	vpand	giny,    giny,	gm4y
	vpaddb	gouty,	gouty,	giny
	vpaddb	[%3],	gouty,	gm5y
%pop
%endmacro
;same as above but with pointer input and output
%macro	tohexdqur_minout_assume 9
%push	scope
	;output and input registers and 5 specificly ordered mask registers
	dgr	%1,	out;clobbered
	dgr	%2,	in;clobbered
	;%3 is the memory output
	;%4 is the memory output
	dgr	%5,	m1;and mask
	dgr	%6,	m2;pshuf mask
	dgr	%7,	m3;0x09mask
	dgr	%8,	m4;0x07mask
	dgr	%9,	m5;0x30mask
	vpmovzxbw	giny,	[%3];spread out input
	vpsllw	gouty,	giny,	4;split it up and offset it
	vpand   gouty,    gouty,	gm1y;and one register with and mask
	vpsrlw	gm1y,	8
	vpand   giny,    giny,	gm1y;and other register with and mask
	vpsllw	gm1y,	8;revert it back for the next loop
	vpor	gouty,	giny,	gouty;combine the two registers
	vpshufb	gouty,	gouty,	gm2y;shuffle bytes around
	vpcmpgtb        giny,    gouty,    gm3y
	vpand	giny,    giny,	gm4y
	vpaddb	gouty,	gouty,	giny
	vpaddb	[%4],	gouty,	gm5y
%pop
%endmacro


;TODO: Fix this macro
%if	0
%macro	tohexbu	2	;to uppercase hex - byte. Fast and small but less modular version.
	%push	scope
	;output on ax
	dgr	%1,	c	;input, must be al, bl, cl or dl for high byte
	dgr	%2,	b	;arithmetic register for multiply
	;split	nibbles into two bytes in input
	mov	gch,	gcb
	shr	gcb,	4
	and	gcw,	0x0f0f
	mov	ax,	gcw
	mov	gb,	7
	sub	ax,	0x0202
	and	ax,	gcw
	and	ax,	0x0808
	mul	gb
	add	ax,	gcw
	add	ax,	0x3030
	%pop
%endmacro
%endif
;note: alt versions that are slower. Made only for use in registers r8 to r15
;To HEX Uppercase Byte Alternative
%macro	tohexbua	3	;to uppercase hex - byte. Slow and large but more modular alt version for r8 to 15.
	%push	scope
	dgr	%1,	a	;output
	dgr	%2,	b	;arithmatic value-holder
	dgr	%3,	c	;input, must be al, bl, cl or dl for high byte
	;split	nibbles into two bytes in input
	mov	gbb,	gcb
	shr	gcb,	4
	shl	gbw,	8
	or	gcw,	gbw
	and	gcw,	0x0f0f
	mov	gbw,	gcw
	sub	gbw,	0x0202
	and	gbw,	gcw
	and	gbw,	0x0808
	shr	gbw,	1
	mov	gaw,	gbw
	shr	gaw,	1
	or	gaw,	gbw
	shr	gaw,	1
	or	gaw,	gbw
	add	gaw,	gcw
	add	gaw,	0x3030
	%pop
%endmacro
%macro	tohexbua	2	;to uppercase hex - byte. Fast and small but less modular alt version for r8-15.
	%push	scope
	;output on ax
	dgr	%1,	b	;arithmatic value-holder
	dgr	%22,	c	;input, must be al, bl, cl or dl for high byte
	;split	nibbles into two bytes in input
	mov	gbb,	gcb
	shr	gcb,	4
	shl	gbw,	8
	or	gcw,	gbw
	and	gcw,	0x0f0f
	mov	gbw,	gcw
	sub	gbw,	0x0202
	and	gbw,	gcw
	and	gbw,	0x0808
	mov	ax,	gbw
	mul	7
	add	ax,	gcw
	add	ax,	0x3030
	%pop
%endmacro

;To HEX Lowercase Byte
%macro thexlb	3
	%push	scope
	dgr	a,	%1	;out on gab
	dgr	b,	%2
	dgr	c,	%3	;in on gcw
	mov	gch,	gcb
	shr	gcb,	4
	and	gcw,	0x0f0f
	mov	gbw,	gcw
	sub	gbw,	0x0202
	and	gbw,	gcw
	and	gbw,	0x0808
	shr	gbw,	3
	mov	gaw,	gbw
	shl	gaw,	2
	or	gaw,	gbw
	shl	gaw,	1
	or	gaw,	gbw
	shl	gaw,	1
	or	gaw,	gbw
	add	gaw,	gcw
	add	gaw,	0x30
	%pop
%endmacro
%macro tohexql	4
	%push	scope
	dgr     %1,     1;output        -       16 byte
	dgr     %2,     2;bitmask       -       16 byte
	dgr     %3,     3;arithmetic    -       16 byte
	dgr     %4,     4;input and broadcast loader -  8 byte
	bswap   g4
	movq    g3x,    g4
	pxor    g2x,    g2x
	vpunpcklbw      g3x,    g2x,    g3x
	movdqu  g2x,    g3x
	psrlw   g2x,    12
	por     g3x,    g2x
	mov     g4,     0x0f0f0f0f0f0f0f0f
	movq    g2x,    g4
	vpbroadcastb    g2x,    g2x
	pand    g3x,    g2x
	mov     g4,     0x0909090909090909
	movq    g2x,    g4
	vpbroadcastq    g2x,    g2x
	vpcmpgtb        g1x,    g3x,    g2x
	mov     g4b,    0xd8
	movq    g2x,    g4
	vpbroadcastb    g2x,    g2x
	pand    g2x,    g1x
	psubb   g1x,    g2x
	paddb   g1x,    g3x
	mov     g4b,    0x30
	movq    g2x,    g4
	vpbroadcastb    g2x,    g2x
	paddb   g1x,    g2x
	%pop
%endmacro
