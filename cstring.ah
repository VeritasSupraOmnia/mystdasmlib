;macro for handling easy string constants in the .data section

;example:	
;	newstr	string_name,	"string you want here"

;output:
;sstringname:	db	"string you want here"
;lstringname:	dq	20

;base newstring macro
%macro	newstr	2
s%1:	db	%2
%strlen	l%[%1]	%2
%endmacro

;appends a linebreak to the end
%macro	newstrla	2
s%1:	db	%2,0x0A
%strlen	l%[%1]	%2
%assign	l%[%1]	l%[%1] + 1
%endmacro

;prepends a linebreak to the beginning
%macro	newstrlp	2
s%1:	db	0x0A,%2
%strlen	l%[%1]	%2
%assign	l%[%1]	l%[%1] + 1
%endmacro
