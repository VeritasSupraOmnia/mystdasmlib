		d_r28	%2
	%elifidni	%1,	r29
		d_r29	%2
	%elifidni	%1,	r30
		d_r30	%2
	%elifidni	%1,	r31
		d_r31	%2
	%elifidni	%1,	eax
		d_rax	%2
	%elifidni	%1,	ebx
		d_rbx	%2
	%elifidni	%1,	ecx
		d_rcx	%2
	%elifidni	%1,	edx
		d_rdx	%2
	%elifidni	%1,	esi
		d_rsi	%2
	%elifidni	%1,	edi
		d_rdi	%2
	%elifidni	%1,	r8d
		d_r8	%2
	%elifidni	%1,	r9d
		d_r9x	%2
	%elifidni	%1,	r10d
		d_r10	%2
	%elifidni	%1,	r11d
		d_r11	%2
	%elifidni	%1,	r12d
		d_r12	%2
