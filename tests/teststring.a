;test the string.ah library

%include	'../cstring.ah'
%include	'../syscall.ah'
global	main
section .data
	%define	tfm	"cstring.ah test failure!"
	%define	tsm	"cstring.ah test success!"
	%strlen	trcl	tfm
	tf:	db	tfm,0x0A
	ts:	db	tsm,0x0A

	control:	db	"Test str"
	newstr	test,	"Test str"
section .code
main:	mov	rax,	[control]
	mov	rdi,	[stest]
	cmp	rax,	rdi
	je	ctest
	mov	rax,	sys_write
	mov	rdi,	stdout
	mov	rsi,	tf
	mov	rdx,	trcl+1
	syscall
	mov	rax,	sys_ret
	mov	rdi,	1
	syscall
ctest:	mov	rax,	8
	mov	rdi,	[ltest]
	cmp	rax,	rdi
	je	success
	mov	rax,	sys_write
	mov	rdi,	stdout
	mov	rsi,	tf
	mov	rdx,	trcl+1
	syscall
	mov	rax,	sys_ret
	mov	rdi,	2
	syscall
success:mov	rax,	sys_write
	mov	rdi,	stdout
	mov	rsi,	ts
	mov	rdx,	trcl+1
	syscall
	mov	rax,	sys_ret
	mov	rdi,	0
	syscall
