;storage macro library
;library to allow the creation of compile time allocation of parallel arrays used to represent , as well as the defines to easily access them, and the runtime allocation of extra soa arrays with the memory management needed to easily access them, possibly by allocating the lookup table on the stack.
;This lookup table should be an aos structure which is headed by the total size in bytes, a simd increment-decrement table so that the various algorithms are able to increment and decrement relevant addresses to keep feeding simd regs aligned data while keeping said increment-decrement data together and in cache, the count of the number of arrays in the table, then the rest is filled in by the start location and size of each array alterenating until the end of the lookup table.



;assembly time parallel storage
;defines chunks of data at assembly time, to store data in bss section, which is ordered in SOA format for optimized simd reads
%macro	atimepstore	1-*
	;arg1 is the id of the structure
	;arg2 is count of indexes
	;args 3 and 4 orderly repeat in an alternating fashon
	;3 is the variable id, 4 is the word type, 5 is the next variable id, 6 is the next word type, and so on.
	;word type means b, w, d, q, x, y, or z for the various register sizes
%push	scope
	%define	%$name	%1
	%define	%$count	%2
	%assign i	 ( %0 - 2 ) / 2
%rep	i
%rotate	2
%ifidni	%2,	x
	%assign scount %$count * 2
	%define	index_size	q	
%elifidni	%2,	y
	%assign scount %$count * 4
	%define	index_size	q
%elifidni	%2,	z
	%assign scount %$count * 8
	%define	index_size	q
%else
	%assign scount	%$count
	%define index_size %2
%endif
%[%$name].%1:	res%[index_size]	scount
%endrep
%pop
%endmacro

;assembly time saving of tabled increment/decrement amounts into the .data section for simd incrementing and decrementing of contiguously placed counters
;quadword, dword, word and byte variants - word and byte variants are only useful for very, very niche system needs

;save 4 quadword incdec sizes into a ymm register
%macro	incdecqy	2-5
	;arg1	name ( ends as incdec.name)
	;arg2-5	are the sizes of each inc/dec size in their char representations(b,w,d,q,x,y,z)
incdec.%1:
	%assign	i	( %0 - 1 )
	%rep	4
	%if	( %0 - 1 ) <=  i
	%rotate	1
	%ifidni	%1,	b
		dq	1
	%elifidni	%1,	w
		dq	2
	%elifidni	%1,	d
		dq	4
	%elifidni	%1,	q
		dq	8
	%elifidni	%1,	x
		dq	16
	%elifidni	%1,	y
		dq	32
	%elifidni	%1,	z
		dq	64
	%endif
	%assign	i	i + 1
	%else
		dq	0
	%endif
	%endrep

%endmacro


;assembly time store lookup table
;put this in the .bss section
%macro	atimestorelookuptableq	1-*
%push	scope
	;arg1	is table name
	;arg2	is count of stores in lookup table
	;arg3+	are the names of the contiguous variable arrays

	%define	%$name	%1
	%define	%$count	%2
	%assign	%$size	( %0 - 2 )
%define	%$name.count	%$count
%assign	%[%$name.size]	%$size * 8	;total size of the array in bytes
	

	%assign	i	0
	%rep	%$count
	%rotate	2
	
	%rep	%$size
%[%$name].%1_%[i].address:	resq	1
%[%$name].%1_%[i].count:	resq	1
	%rotate	1
	%endrep

	%assign	i	i + 1
	%endrep

%pop
%endmacro
