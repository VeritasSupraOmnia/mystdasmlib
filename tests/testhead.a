%include	"./syscall.ah"
%include	"./head.ah"

;declare standard, 64 bit elf header with entry-point "main"
c_ehdr	64,	main,	8 + bss_size

;my god why did I declare this after the main label. I swear to god, I was tearing my hair out trying to figure out why I was segfaulting. I am a fucking brainlet sometimes.
%define		msucc	"head.ah		Test success!"
%define		mfail	"head.ah		Test failure!"
%strlen		len	msucc
;cmd args test data
cmdarg1:	db	"arg1",0
cmdarg2:	db	"arg2",0
cmdarg3:	db	"arg3",0
nl:		db	0x0a

ssucc:	db	msucc,0x0A
sfail:	db	mfail,0x0A
fail:
	printbuff	sfail,	len+1
	jmp end
main:	
	jmp test_bss	; TEMPORARY FOR TESTING PURPOSES
	;TESTING COMMANDLINE ARGUMENT COUNT

	;register
	rargc	rcx
	cmp	ecx,	4
	jne	fail

	;direct memcopy scratching rsi and rdi
	margc	cmdargc
	cmp	qword [cmdargc],	4
	jne	fail

	;testing commandline argument indexing
	rargv	rsi
	mov	rcx,	1
	riargvr	rax,	rsi,	rcx
	mov	eax,	[rax]
	mov	ebx,	[cmdarg1]
	cmp	eax,	ebx
	jne	fail
test_bss:
	mov [temp], rax

	printbuff	ssucc,	len+1
end:
	mov	rax,	sys_ret
	mov	rdi,	0
	syscall

;declare footer, just finds file end address for header generation
c_ftr
bsq cmdargc,	1
bsq cmdarvin,	1
bsq temp, 40
e_bss
