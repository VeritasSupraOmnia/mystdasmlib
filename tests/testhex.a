%include	'../cstring.ah'
%include	'../hex.ah'
%include	'../genreg.ah'
%include	'../syscall.ah'
%include	'../size.ah'
global	main

section .data
	newstrla	failure,	"hex.ah		Test failure!"
	newstrla	success,	"hex.ah		Test success!"
	
	;testing data is as follows: first char in label is size, second is whether it is converted to or from hexadecimal, third is whether it is the test or desired result, fourth is whether output is uppercase. 
	;example1:	btt - byte to hexadecimal test 
	;example2:	qfr - quadword from hexidecimal result 

	;note: result data is always 2x the size of test data

	;test over one byte
	bytebin:	db	0x9A
	bytehexu:	dw	'9A'
	bytehexl:	dw	'9a'
	dwordbin:	dd	0x02468ACE
	dwordhexu:	dq	'02468ACE'
	quadbin:	dq	0x0123456789ABCDEF
	quadhexu:	dq	'01234567','89ABCDEF'
section	.code
main:
	mov	dl,	[bytebin]
	xor	rsi,	rsi
	xor	rdi,	rdi
	tohexbu	rdi,	rsi,	rdx
	mov	ax,	[bytehexu]
	cmp	ax,	di
	jne	failure

	mov	dl,	[bytebin]
	xor	rsi,	rsi
	xor	rdi,	rdi
	tohexbua	rdi,	rsi,	rdx
	mov	ax,	[bytehexu]
	cmp	ax,	di
	jne	failure
	
	mov	dx,	[bytehexu]
	frhexbu	ax,	di, dx
	mov	dl,	[bytebin]
	cmp	al,	dl
	jne	failure
	
%if	0
	mov	cl,	[bytebin]
	xor	r8,	r8
	tohexbu	cl,	r8
	mov	dx,	[bytehexu]
	cmp	ax,	dx
	jne	failure
%endif
	
	mov	edx,	[dwordbin]
	xor	rsi,	rsi
	xor	rdi,	rdi
	tohexdu	rdi,	rsi,	rdx
	mov	rax,	[dwordhexu]
	cmp	rax,	rdi
	jne	failure

	mov	r10,	[quadbin]
	tohexqu	xmm0,	xmm1,	xmm2,	r8,	r9,	r10
	movdqu	xmm1,	[quadhexu]
	pandn	xmm1,	xmm1
	ptest	xmm0,	xmm1
	jnz	failure

;under testing (frhexqu)
%if	0	
	movdqu	xmm0,	[quadhexu]
	frhexqu	rax,	rdi,	rsi,	xmm2,	xmm1,	xmm0
	tohexqu	xmm0,	xmm1,	xmm2,	rsi,	rdi,	rax
	movdqu	[quadhexu],	xmm0
	mov	rax,	sys_write
	mov	rdi,	stdout
	mov	rsi,	quadhexu
	mov	rdx,	xsize(1)
	syscall
	;mov	rdi,	[quadbin]
	;cmp	rax,	rdi
	;jne	failure
%endif
	jmp	success
failure:mov	rax,	sys_write
	mov	rdi,	stdout
	mov	rsi,	sfailure
	mov	rdx,	[lfailure]
	syscall
	mov	rax,	sys_ret
	mov	rdi,	1
	syscall
success:mov	rax,	sys_write
	mov	rdi,	stdout
	mov	rsi,	ssuccess
	mov	rdx,	[lsuccess]
	syscall
	mov	rax,	sys_ret
	mov	rdi,	0
	syscall
