%include	"./genreg.ah"
%include	"./head.ah"
%include	"./syscall.ah"
%include	"./cstring.ah"
%include	"./util.ah"
%include	"./find.ah"
;%include	"./hex.ah"
;%include	"./regstats.ah"
c_ehdr	64,	main,	0
;	baseregbindata	1
;	basereghexdata	1
;	basereghoutdata	1
;	avx2regbindata	1
;	avx2reghexdata	1
;	avx2regoutdata	1

	newstrla	success,	"find.ah		Test success!"
	newstrla	failure,	"find.ah		Test failure!"
	newstr		stof,		"fff1"
	newstr		stosw,		"234fff1f";should return found
	newstr		stos32,		"ffaaccllbb2233442288990011fff1gf"
	res32:		dq		0x1A
	res8:		dq		0x03
main:	
	xor	r8,	r8
	xor	rdx,	rdx
	mov	r10,	4
	mov	r8d,	[sstof]
	mov	rdx,	[sstosw]
	fndq	rax,	rdx,	r8,	r10,	r9,	rdi
	mov	rdx,	[res8]
	cmp	rax,	rdx
	jne	fail

;test for contains
	mov	al,	"2"
	vmovdqu	ymm0,	[sstos32]
	bcontainsy	al,	ymm0,	ymm1
	jz	fail
;test for !contains
	mov	al,	"5"
	vmovdqu	ymm0,	[sstos32]
	bcontainsy	al,	ymm0,	ymm1
	jnz	fail

;	xor	r8,	r8
;	xor	rdx,	rdx,
;	mov	r10,	4
;	vmovdqu	ymm0,	[sstos32]
;	mov	r8d,	[sstof]
;	fndy	rax,	ymm0,	r8,	r10,	r9,	rdi,	rdx,	ymm1
;	mov	rdx,	[res32]
;	cmp	rax,	rdx
;	jne	fail

	write	stdout,	ssuccess,	lsuccess
	jmp	end
fail:	
	write	stdout,	sfailure,	lfailure
end:	
	;baseregconvm	1,	1,	xmm0,	xmm1,	xmm2,	r8
	;baseregformat	1,	1,	xmm0
	;write	stdout,	s_rax1,	odat_totalsize
	;avx2regconvm	1,	1,	xmm0,	xmm1,	xmm2,	r8
	;avx2regformat	1,	1,	xmm0
	;write	stdout,	s_ymm01,	oavx2_totalsize
	mov	rax,	sys_ret
	mov	rdx,	0
	syscall
c_ftr
