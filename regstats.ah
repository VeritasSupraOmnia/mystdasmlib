;format dec data into a console readable format
%macro	baseregdformat	5;1:output|2:input|3-4:free avx reg|5:free base reg
%push	scope	
	dgr	%3,	t;temp
	dgr	%4,	m;mask
	dgr	%5,	f;feed
	mov	gf,	0xffffffffffffffff
	movq	gmx,	gf
	vpbroadcastq	gmy,	gmx
	mov	gf,	0x00000000ffffffff
	movq	gmx,	gf
	vpermq	gmy,	gmy,	0b01001111
	vmovdqu	gty,	[d_rax%2]
