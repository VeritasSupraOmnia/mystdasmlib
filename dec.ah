;sets of macros able to convert binary to decimal and decimal to binary.
;needs genreg
;due to the nature of division, this cannot have a truely generic register selection
%macro	todecb	2
	;in on al
	;scratches rax and rdx in addition to general registers
	;out on g1d
	;g2 is an arith reg
%push	scope
	dgr	%1,	1
	dgr	%2,	2
	xor	rdx,	rdx
	xor	g1,	g1
	mov	g2b,	100
	div	g2d
	mov	g1b,	al
	mov	ax,	dx
	xor	rdx,	rdx
	shl	g1w,	8
	mov	g2b,	10
	div	g2d
	or	g1d,	eax
	shl	g1d,	8
	or	g1d,	edx
	or	g1d,	0x30303030
	bswap	g1d
%pop
%endmacro
%macro	todecw	2
%push	scope
	dgr	%1,	1
	dgr	%2,	2
	xor	rdx,	rdx
	xor	g1,	g1
	mov	g2,	10000
	div	g2
	mov	g1,	rax
	mov	rax,	rdx
	xor	rdx,	rdx
	shl	g1,	8
	mov	g2,	1000
	div	g2
	or	g1,	rax
	mov	rax,	rdx
	xor	rdx,	rdx
	mov	g2,	100
	shl	g1,	8
	div	g2
	or	g1,	rax
	mov	rax,	rdx
	xor	rdx,	rdx
	shl	g1,	8
	mov	g2,	10
	div	g2
	or	g1,	rax
	shl	g1,	8
	or	g1,	rdx
	mov	g2,	0x3030303030303030
	or	g1,	g2
	bswap	g1
%pop
%endmacro

;TODO:	RE-WRITE THIS TRASH
;todo:	instead of movdqu-ing every byte found, build the string into an 8 byte register, load it into the xmm loader, permq the data in output
;	register left and out of the way if needed, then or the loader reg into the output reg.
;	If it's the first qword calculated (first 6 bytes zeroed), only movd into the output.
;in on eax,	scratches that and edx
%macro	todecd	4
%push	scope
	dgr	%1,	1;xmm output 
	dgr	%2,	2;xmm loader
	dgr	%3,	3;8byte digit of 10 checker
	dgr	%4,	4;xmm mask
	xor	rdx,	rdx
	mov	g3,	1000000000
	div	g3
	movd	g1x,	eax
	pslldq	g1x,	1
	mov	rax,	rdx
	xor	rdx,	rdx
	%assign	it	100000000
	%rep	7
	mov	g3,	it
	div	g3
	movd	g2x,	eax
	por	g1x,	g2x
	pslldq	g1x,	1
	mov	rax,	rdx
	xor	rdx,	rdx
	%assign	it	it / 10
	%endrep
	mov	g3,	10
	div	g3
	movd	g2x,	eax
	por	g1x,	g2x
	pslldq	g1x,	1
	movd	g2x,	edx
	por	g1x,	g2x
	mov	g3,	0x3030303030303030
	movq	g2x,	g3
	vpbroadcastq	g2x,	g2x
	por	g1x,	g2x
	mov	g3,	0x0001020304050607
	movq	g2x,	g3
	pslldq	g2x,	8
	mov	g3,	0x08090A0B0C0D0E0F
	movq	g4x,	g3
	por	g2x,	g4x
	pshufb	g1x,	g2x
%pop
%endmacro

;in on rax,	scratches both rax and rdx
%macro	todecq	4
%push	scope
	dgr	%1,	1;ymm output
	dgr	%2,	2;8 byte builder reg
	dgr	%3,	3;8 byte dividend reg
	dgr	%4,	4;ymm loader

	xor	g2,	g2

	%assign	i	10000000000000000000
	%rep	4
	xor	rdx,	rdx
	mov	g3,	i
	div	g3
	shl	g2,	8
	or	g2,	rax
	mov	rax,	rdx
	%assign	i	i / 10
	%endrep
	
	vpxor	g1y,	g1y,	g1y
	bswap	g2
	movq	g1x,	g2
	vpermq	g1y,	g1y,	0b11110011
	xor	g2,	g2

	%assign	i	1000000000000000
	%rep	8
	xor	rdx,	rdx
	mov	g3,	i
	div	g3
	shl	g2,	8
	or	g2,	rax
	mov	rax,	rdx
	%assign	i	i / 10
	%endrep
	
	vpxor	g4y,	g4y,	g4y
	bswap	g2
	movq	g4x,	g2
	vpor	g1y,	g1y,	g4y
	vpermq	g1y,	g1y,	0b11010011
	xor	g2,	g2

	%assign	i	10000000
	%rep	8
	xor	rdx,	rdx
	mov	g3,	i
	div	g3
	shl	g2,	8
	or	g2,	rax
	mov	rax,	rdx
	%assign	i	i / 10
	%endrep

	vpxor	g4y,	g4y,	g4y
	bswap	g2
	movq	g4x,	g2
	vpor	g1y,	g1y,	g4y
	vpermq	g1y,	g1y,	0b00011011
	mov	g2,	0x3030303030303030
	movq	g4x,	g2
	vpbroadcastq	g4y,	g4x
	vpor	g1y,	g1y,	g4y
%pop
%endmacro

;to decimal align left
;output of program is shifted left so that byte 12 (first possible qword decimal digit) is leftmost in the output yword register.
;in on rax,	scratches both rax and rdx
;if you want to clear exactly 20 bytes to or in, g4y is a ff mask of the digits you can vpandn on itself then vpand it and data from a memory address to clear 20 bytes and store into g4y, then vpor g4y into g1y, then vmovdqu into the original memory address.
%macro	todecqa	4
%push	scope
	dgr	%1,	1;ymm output
	dgr	%2,	2;8 byte builder reg
	dgr	%3,	3;8 byte dividend reg
	dgr	%4,	4;ymm loader

	xor	g2,	g2

	%assign	i	10000000000000000000
	%rep	8
	xor	rdx,	rdx
	mov	g3,	i
	div	g3
	shl	g2,	8
	or	g2,	rax
	mov	rax,	rdx
	%assign	i	i / 10
	%endrep
	
	vpxor	g1y,	g1y,	g1y
	bswap	g2
	movq	g1x,	g2
	vpermq	g1y,	g1y,	0b00101010
	xor	g2,	g2

	%assign	i	100000000000
	%rep	8
	xor	rdx,	rdx
	mov	g3,	i
	div	g3
	shl	g2,	8
	or	g2,	rax
	mov	rax,	rdx
	%assign	i	i / 10
	%endrep
	
	vpxor	g4y,	g4y,	g4y
	bswap	g2
	movq	g4x,	g2
	vpor	g1y,	g1y,	g4y
	vpermq	g1y,	g1y,	0b11000101
	xor	g2,	g2

	%assign	i	1000
	%rep	4
	xor	rdx,	rdx
	mov	g3,	i
	div	g3
	shl	g2,	8
	or	g2,	rax
	mov	rax,	rdx
	%assign	i	i / 10
	%endrep
	vpxor	g4y,	g4y,	g4y
	bswap	g2
	shr	g2,	32
	movq	g4x,	g2
	vpor	g1y,	g1y,	g4y
	vpermq	g1y,	g1y,	0b01001011
	mov	g2,	0x3030303030303030
	movq	g4x,	g2
	vpbroadcastq	g4y,	g4x
	vpor	g1y,	g1y,	g4y
	mov	g2,	0xffffffffffffffff
	movq	g4x,	g2
	vpbroadcastq	g4y,	g4x
	mov	g2,	0x00000000ffffffff
	movq	g4x,	g2
	vpermq	g4y,	g4y,	0b01001111
	vpand	g1y,	g1y,	g4y
%pop
%endmacro
%macro	todec2d	3
%push	scope
	dgr	%1,	o;yword output	
	dgr	%2,	in;quadword input
	dgr	%3,	1
	dgr	%4,	2
	movd	g1x,	gind
	shr	gin,	32
	movd	gox,	gind
	vperm2i128	g1y,	g1y,	goy,	0b00100000

%pop
%endmacro

%macro	frdecb	2
%push	scope
	dgr	%1,	1;output
	dgr	%2,	2;input
	;scratches rax and rdx
	bswap	g2d;register binary is little endian but decimal chars are stored big endian
	and	g2d,	0x0f0f0f0f
	xor	g1,	g1
	mov	g1b,	g2b
	shr	g2,	8
	mov	rdx,	10
	xor	rax,	rax
	mov	al,	g2b
	mul	rdx
	add	g1,	rax
	shr	g2,	8
	xor	rax,	rax
	mov	rdx,	100
	mov	al,	g2b
	mul	rdx
	add	g1,	rax
%pop
%endmacro
%macro	frdecw	2
%push	scope
	dgr	%1,	1;output
	dgr	%2,	2;input
	;scratches rax and rdx
	bswap	g2;register binary is little endian but decimal chars are stored big endian
	mov	g1,	0x0f0f0f0f0f0f0f0f
	and	g2,	g1
	xor	g1,	g1
	mov	g1b,	g2b
	shr	g2,	8
	mov	rdx,	10
	xor	rax,	rax
	mov	al,	g2b
	mul	rdx
	add	g1,	rax
	shr	g2,	8
	xor	rax,	rax
	mov	rdx,	100
	mov	al,	g2b
	mul	rdx
	add	g1,	rax
	shr	g2,	8
	xor	rax,	rax
	mov	rdx,	1000
	mov	al,	g2b
	mul	rdx
	add	g1,	rax
	shr	g2,	8
	xor	rax,	rax
	mov	rdx,	10000
	mov	al,	g2b
	mul	rdx
	add	g1,	rax
%pop
%endmacro
;scratches rax and rdx
%macro	frdecq	4
%push	scope
	dgr	%1,	o;8 byte output binary data
	dgr	%2,	in;20 byte input decimal data
	dgr	%3,	1;temporary register one
	dgr	%4,	2;temp reg 2
	vpermq	giny,	giny,	0b11111001
	movq	g1,	ginx
	shr	g1,	32
	mov	g2,	0x0f0f0f0f0f0f0f0f
	and	g1,	g2
	xor	eax,	eax
	mov	al,	g1b
	mov	g2,	10000000000000000000
	mul	g2
	mov	go,	rax
	%assign	i	1000000000000000000
	%rep	3
	shr	g1,	8
	xor	eax,	eax
	mov	al,	g1b
	mov	rdx,	i
	%assign	i	i / 10
	mul	rdx
	add	go,	rax
	%endrep
	
	%rep	2
	vpermq	giny,	giny,	0b11111001
	movq	g1,	ginx
	mov	g2,	0x0f0f0f0f0f0f0f0f
	and	g1,	g2
	%rep	8
	xor	eax,	eax
	mov	al,	g1b
	mov	rdx,	i
	%assign	i	i / 10
	mul	rdx
	add	go,	rax
	shr	g1,	8
	%endrep
	%endrep
%pop
%endmacro
;NOTE:	There has got to be a way to do simd decimal conversions...
