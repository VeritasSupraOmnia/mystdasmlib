;saving of raw data
%macro	takebaseregs 1
	mov	[b_rax%1],	rax
	mov	[b_rbx%1],	rbx
	mov	[b_rcx%1],	rcx
	mov	[b_rdx%1],	rdx
	mov	[b_rbp%1],	rbp
	mov	[b_rsp%1],	rsp
	mov	[b_rdi%1],	rdi
	mov	[b_rsi%1],	rsi
	mov	[b_r8%1],	r8
	mov	[b_r9%1],	r9
	mov	[b_r10%1],	r10
	mov	[b_r11%1],	r11
	mov	[b_r12%1],	r11
	mov	[b_r13%1],	r13
	mov	[b_r14%1],	r14
	mov	[b_r15%1],	r15
%endmacro


;for making a static takebaseregs to call to
%macro	static_Takebaseregs 1
call_Takebaseregs:	takebaseregs	%1
	ret
%endmacro

