;needs genreg.ah
%define	hex	1
;To HEX Uppercase Byte

%macro	tohexbu	3	;to uppercase hex - byte. Slow and large but more modular version.
	%push	scope
	dgr	%1,	a	;output
	dgr	%2,	b	;arithmatic value-holder
	dgr	%3,	c	;input, must be al, bl, cl or dl for high byte
	;split	nibbles into two bytes in input
	mov	gch,	gcb
	shr	gcb,	4
	and	gcw,	0x0f0f
	mov	gbw,	gcw
	sub	gbw,	0x0202
	and	gbw,	gcw
	and	gbw,	0x0808
	shr	gbw,	1
	mov	gaw,	gbw
	shr	gaw,	1
	or	gaw,	gbw
	shr	gaw,	1
	or	gaw,	gbw
	add	gaw,	gcw
	add	gaw,	0x3030
	%pop
%endmacro

;From DEX Uppercase Byte
%macro	frhexbu	3
	%push	scope
	dgr	%1,	1;output
	dgr	%2,	2;arithmetic reg
	dgr	%3,	3;input - this is a word in size
	
	mov	g2w,	g3w
	and	g2w,	0x4040
	shr	g2w,	4
	mov	g1w,	g2w
	shr	g1w,	1
	or	g2w,	g1w
	shr	g1w,	1
	or	g2w,	g1w
	sub	g3w,	g2w
	ror	g3w,	8
	mov	g2w,	0x0f0f
	pext	g1d,	g3d,	g2d
	%pop
%endmacro

%macro	tohexdu 3
	%push	scope
	dgr	%1,	1;output	-	8 bytes
	dgr	%2,	2;arithmetic	-	8 bytes
	dgr	%3,	3;input		-	4 bytes
	
	mov	g2,	0x0f0f0f0f0f0f0f0f
	pdep	g1,	g3,	g2
	mov	g2,	g1
	mov	g3,	0x0202020202020202
	sub	g2,	g3
	mov	g3,	0x0808080808080808
	and	g2,	g3
	and	g2,	g1
	shr	g2,	1
	mov	g3,	0x3030303030303030
	or	g1,	g3
	mov	g3,	g2
	shr	g3,	1
	or	g2,	g3
	shr	g3,	1
	or	g2,	g3
	add	g1,	g2
	bswap	g1
	%pop
%endmacro
%macro	frhexdu	3
	%push	scope
	dgr	%1,	1;output	-	4 bytes
	dgr	%2,	2;arithmetic	-	8 bytes
	dgr	%3,	3;input		-	8 bytes
	
	mov	g2,	0x4040404040404040
	and	g2,	g3
	shr	g2,	4
	mov	g1,	g2
	shr	g1,	1
	or	g2,	g1
	shr	g1,	1
	or	g2,	g1
	sub	g3,	g2
	mov	g2,	0x0f0f0f0f0f0f0f0f
	bswap	g3
	pext	g1,	g3,	g2
	
	%pop
%endmacro

%macro	tohexqu	4
	%push	scope
	dgr     %1,     1;output        -       16 byte
	dgr     %2,     2;bitmask       -       16 byte
	dgr     %3,     3;arithmetic    -       16 byte
	dgr     %4,     4;input and broadcast loader -  8 byte
	bswap   g4
	movq    g3x,    g4
	pxor    g2x,    g2x
	vpunpcklbw      g3x,    g2x,    g3x
	movdqu  g2x,    g3x
	psrlw   g2x,    12
	por     g3x,    g2x
	mov     g4,     0x0f0f0f0f0f0f0f0f
	movq    g2x,    g4
	vpbroadcastb    g2x,    g2x
	pand    g3x,    g2x
	mov     g4,     0x0909090909090909
	movq    g2x,    g4
	vpbroadcastq    g2x,    g2x
	vpcmpgtb        g1x,    g3x,    g2x
	mov     g4b,    0xf8
	movq    g2x,    g4
	vpbroadcastb    g2x,    g2x
	pand    g2x,    g1x
	psubb   g1x,    g2x
	paddb   g1x,    g3x
	mov     g4b,    0x30
	movq    g2x,    g4
	vpbroadcastb    g2x,    g2x
	paddb   g1x,    g2x
	%pop
%endmacro
%macro	frhexqu	6
	%push	scope
	dgr   	%1,     1;output reg-   8bytes
	dgr     %2,     2;mask reg  -   8bytes
	dgr     %3,     3;cross reg -   8bytes
	dgr     %4,     4;arith reg -   16bytes
	dgr     %5,     5;arith reg -   16bytes
	dgr     %6,     6;input reg -   16bytes
	mov     g2,     0x4040404040404040
	movq    g5x,    g2
	vpbroadcastq    g5x,    g5x
	pand    g5x,    g6x
	psrlw   g5x,    4
	movdqu  g4x,    g5x
	psrlw   g5x,    1
	por     g4x,    g5x
	psrlw   g5x,    1
	por     g4x,    g5x
	psubb   g6x,    g4x
	mov     g2,     0x0f0f0f0f0f0f0f0f
	movq    g3,     g6x
	pext    g1,     g3,     g2
	pextrq  g3,     g6x,    1
	pext    g2,     g3,     g2
	shl     g2,     32
	or      g1,     g2
	mov     g2,     g1
	mov     g3,     0xf0f0f0f0f0f0f0f0
	shr     g2,     4
	shl     g1,     4
	and     g1,     g3
	shr     g3,     4
	and     g2,     g3
	or      g1,     g2
	bswap   g1
	%pop
%endmacro
%macro	frhexql	6
	%push	scope
	dgr   	%1,     1;output reg-   8bytes
	dgr     %2,     2;mask reg  -   8bytes
	dgr     %3,     3;cross reg -   8bytes
	dgr     %4,     4;arith reg -   16bytes
	dgr     %5,     5;arith reg -   16bytes
	dgr     %6,     6;input reg -   16bytes
	mov     g2b,     0x60
	movq    g5x,    g2
	vpbroadcastb    g5x,    g5x
	vpand   g4x,	g5x,    g6x
	pcmpeqb	g5x,	g4x
	mov	g2b,	0x27
	movq	g4x,	g2
	vpbroadcastb	g4x,	g4x
	pand	g5x,	g4x
	psubb   g6x,    g5x
	mov     g2b,     0x0f
	movq	g4x,	g2
	vpbroadcastb	g4x,	g4x
	pand	g6x,	g4x
	movdqu	g5x,	g6x
	psrldq	g5x,	1
	psllw	g6x,	4
	mov	g2,	0x0E0C0A0806040200
	movq	g4x,	g2
	pshufb	g6x,	g4x
	pshufb	g5x,	g4x
	por	g6x,	g5x
	movq	g1,	g6x
	bswap	g1
	%pop
%endmacro
%macro	frhexdqu	6
	%push	scope
	dgr   	%1,     1;output reg-   16bytes
	dgr     %2,     2;mask reg  -   8bytes
	dgr     %3,     3;cross reg -   16bytes
	dgr     %4,     4;arith reg -   16bytes
	dgr     %5,     5;arith reg -   16bytes
	dgr     %6,     6;input reg -   16bytes
	mov     g2b,     0x40
	movd    g5x,    g2d
	vpbroadcastb    g5y,    g5x
	vpand	g4y,	g5y,	g6y
	vpcmpeqb	g5y,	g4y,	g5y
	mov	g2b,	0x07
	movd	g4x,	g2d
	vpbroadcastb	g4y,	g4x
	vpand	g5y,	g5y,	g4y
	vpsubb	g1y,	g6y,	g5y
	mov	g2w,	0x000f
	movd	g5x,	g2d
	vpbroadcastw	g5y,	g5x
	vpand	g3y,	g1y,	g5y
	vpsllw	g5y,	g5y,	8
	vpand	g1y,	g1y,	g5y
	vpsrlw	g1y,	g1y,	4
	vpor	g1y,	g1y,	g3y
	mov	g2,	0x0e0c0a0806040200
	movq	g3x,	g2
	vpermq	g3y,	g3y,	0b10001000
	vpshufb	g1y,	g1y,	g3y
	vpermq	g1y,	g1y,	0b11110010
	%pop
%endmacro

;TODO:	this was just copied from tohexqu. suppose to be 16 byte binary to 32 byte hex using ymm registers
%macro	tohexdqu	4
	%push	scope
	dgr     %1,     1;output	-	32 byte
	dgr     %2,     2;bitmask	-	32 byte
	dgr     %3,     3;input binary	-	16 byte
	dgr     %4,     4;bitmask loader-	8 byte
	vpunpcklbw      g2y,    g3y,    g3y
	vpunpckhbw      g3y,    g3y,    g3y
	vperm2i128	g3y,	g2y,	g3y,	0x02
	vmovdqu  g2y,    g3y
	vpsrlw   g3y,    4
	mov     g4,     0x0f000f000f000f00
	movq    g1x,    g4
	vpbroadcastq    g1y,    g1x
	vpand   g3y,    g3y,	g1y
	vpsrlw	g1y,	8
	vpand   g2y,    g2y,	g1y
	vpor     g3y,    g2y,	g3y
	mov     g4,     0x0909090909090909
	movq    g2x,    g4
	vpbroadcastq    g2y,    g2x
	vpcmpgtb        g1y,    g3y,    g2y
	mov     g4b,    0x07
	movq    g2x,    g4
	vpbroadcastb    g2y,    g2x
	vpand	g1y,    g1y,	g2y
	vpaddb	g1y,	g1y,	g3y
	mov     g4b,    0x30
	movq    g2x,    g4
	vpbroadcastb    g2y,    g2x
	vpaddb   g1y, 	g1y,	g2y
	%pop
%endmacro
