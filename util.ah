;miscellaneous utilites for speeding up the coding of various common functions of basic programs
%define	util	1

;Needs genreg.ah for macro malleability.

;ReaD Zero Terminate STRing
;zero terminates a string of bytes from an array and reads it into an r64 reg
;currenly useful for short, but not byte-long, arguments passed on the command line
%macro  rdztstr       4
	dgr     %1,     1;zeroed output register
	dgr     %2,     2;read-into register
	dgr     %3,     3;zeroed test-against register
	dgr     %4,     4;input address of first character
%%arl   mov     g2b,    [g4]
	cmp     g2b,    g3b
	je      %%earg;end of arg if null char detected
	shl     g1,     8
	or      g1,     g2
	inc     g4
	jmp     %%arl;arg read loop
%%earg: bswap   g1
	udgr    1
	udgr    2
	udgr    3
	udgr    4
%endmacro

;same as above but counts the size of the register in a specified register
%macro  rdztstrc       5
	dgr     %1,     1;zeroed output register
	dgr     %2,     2;read-into register
	dgr     %3,     3;zeroed test-against register
	dgr     %4,     4;input address of first character
	dgr	%5,	5;count of chars(gets incremented)
%%arl   mov     g2b,    [g4]
	cmp     g2b,    g3b
	je      %%earg;end of arg if null char detected
	shl     g1,     8
	or      g1,     g2
	inc     g4
	inc	g5
	jmp     %%arl;arg read loop
%%earg: bswap   g1
	udgr    1
	udgr    2
	udgr    3
	udgr    4
	udgr    5
%endmacro

;reverses the byte order of each double quadword reg in a y reg
%macro	byteswapdqreg	5
	dgr	%1,	o
	dgr	%2,	t1
	dgr	%3,	t2
	dgr	%4,	load
	dgr	%5,	i
	
	mov	gload,	0x0123456789ABCDEF
	movq	gt1x,	gload
	pxor	gt2x,	gt2x
	punpcklbw	gt2x,	gt1x
	movdqu	gt1x,	gt2x
	psrlw	gt1x,	8
	psrlw	gt2x,	4

	mov	gload,	0x0f000f000f000f00
	movq	gox,	gload
	vpbroadcastq	gox,	gox
	pand	gt2x,	gox
	psrlw	gox,	8
	pand	gt1x,	gox
	por	gt1x,	gt2x
	vperm2i128	gt1y,	gt1y,	gt1y,	0x00
	vpshufb	goy,	giy,	gt1y

	udgr	o
	udgr	t1
	udgr	t2
	udgr	load
	udgr	i
%endmacro
;reverse the order of each nibble (half byte) in each quadword in an avx2 register
%macro	nibswapqreg	5
	dgr	%1,	o
	dgr	%2,	t1
	dgr	%3,	t2
	dgr	%4,	load
	dgr	%5,	i

	mov	gload,	0x89ABCDEF01234567
	movq	gt1x,	gload
	pxor	gt2x,	gt2x
	punpcklbw	gt2x,	gt1x
	movdqu	gt1x,	gt2x
	psrlw	gt1x,	8
	psrlw	gt2x,	4

	mov	gload,	0x0f000f000f000f00
	movq	gox,	gload
	vpbroadcastq	gox,	gox
	pand	gt2x,	gox
	psrlw	gox,	8
	pand	gt1x,	gox
	por	gt1x,	gt2x
	vperm2i128	gt1y,	gt1y,	gt1y,	0x00
	vpshufb	gt1y,	giy,	gt1y

	mov	gload,	0xf0f0f0f0f0f0f0f0
	movq	gox,	gload
	vpbroadcastq	goy,	gox
	vmovdqu	gt2y,	gt1y
	vpsllw	gt2y,	gt2y,	4
	vpand	gt2y,	gt2y,	goy
	vpsrlw	gt1y,	gt1y,	4
	vpsrlw	goy,	goy,	4
	vpand	gt1y,	gt1y,	goy
	vpor	goy,	gt1y,	gt2y

	udgr	o
	udgr	t1
	udgr	t2
	udgr	load
	udgr	i
%endmacro
