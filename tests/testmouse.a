		db 0b10000000

c_ftr
bsb offsetbeg, (width*height*4)/2
bsb buffer, width*height*4
bsb offsetmid, (width*height*4)/2
alignb 4096
bsb fbuffer, (width*height*4)
bsb offsetend, (width*height*4)/2
alignb 4096
bsb ybuffer, (width*height*4)	; yank buffer -yank-
bsd yb_x,	1					; yank buffer x, y and total size
bsd yb_y,	1
bsq yb_t,	1
bsb	inbuffer, 100
curlocstruc marker
curlocbuffstruc marker			;	-mark_coord-		--marked_coord--
curlocstruc other_marker
curlocbuffstruc other_marker	;	-mark_other_coord-	--other_marked_coord--
termios_struct tios
mouseinbuff 0
curlocstruc 0
alignb 16	; for proper inter thread communication
curlocbuffstruc 0
e_bss
