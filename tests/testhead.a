%include	"../syscall.ah"
%include	"../cstring.ah"
%include	"../head.ah"

;declare standard, 64 bit elf header with entry-point "main"
c_ehdr	64,	main

;my god why did I declare this after the main label. I swear to god, I was tearing my hair out trying to figure out why I was segfaulting. I am a fucking brainlet sometimes.
newstrla	succ,	"head.ah		Test success!"

main:	
	write	stdout,	ssucc,	[lsucc]
	mov	rax,	sys_ret
	mov	rdi,	0
	syscall

;declare footer, just finds file end address for header generation
c_ftr
